<script setup lang="ts">
import { ref } from 'vue'
import { useStore } from '@/.cool'
import { getPublicMessageList, getRecentActivity, type PlazaMessage, type RecentActivity } from '@/api/message'
import { loginByMiniCode } from '@/api/user'
import { mergeOssPath } from '@/utils/oss'

const { user } = useStore()
const currentBanner = ref(0)
const bannerVisible = ref(false)
const bannerKey = ref(0)
const stories = ref<PlazaMessage[]>([])
const recentActivity = ref<RecentActivity>({ sentCount: 0, replyCount: 0, deliveredCount: 0, date: '' })
const homeInitialized = ref(false)
let homeInitializing = false

/** 首页最先建立登录态，再发起依赖用户身份的首页请求。 */
async function initializeUser() {
  // #ifdef MP-WEIXIN
  try {
    const result: any = await new Promise((resolve, reject) => {
      uni.login({ provider: 'weixin', success: resolve, fail: reject })
    })
    if (result.code) {
      const token = await loginByMiniCode(result.code)
      user.setToken(token)
    }
  }
  catch (err) {
    console.warn('小程序静默登录失败', err)
  }
  // #endif

  // 小程序静默登录完成后同步资料；App 等端则使用已有 token 同步。
  await user.get()
}

const bannerList = [
  { image: mergeOssPath('home/banner-1.png') },
  { image: mergeOssPath('home/banner-2.png') },
  { image: mergeOssPath('home/banner-3.png') },
  { image: mergeOssPath('home/banner-4.png') },
]

const quickCards = [
  {
    title: '表达心意', desc: '帮你表达真心话', image: mergeOssPath('home/home-send.png'),
    route: '/package-send/send', cardClass: 'quick-card-heart', arrowClass: 'quick-arrow-heart',
  },
  {
    title: '我的对话', desc: '查看历史对话记录', image: mergeOssPath('home/home-chat.png'),
    route: '/pages/message', routeType: 'switch', cardClass: 'quick-card-chat', arrowClass: 'quick-arrow-chat',
  },
]

const activityCards = [
  { key: 'sentCount', label: '你发送了', suffix: '条消息', image: mergeOssPath('home/home-icon-send.png') },
  { key: 'replyCount', label: '收到', suffix: '条回复', image: mergeOssPath('home/home-icon-back.png') },
  { key: 'deliveredCount', label: '已送达', suffix: '条消息', image: mergeOssPath('home/home-icon-edit.png') },
]

function onBannerChange(e: any) {
  currentBanner.value = e.detail.current
}

/**
 * tabBar 页面会被缓存。离开时销毁 swiper，重新进入时用新 key 创建实例，
 * 避免原生 swiper 的自动播放定时器沿用或叠加。
 */
function resetBanner() {
  currentBanner.value = 0
  bannerKey.value += 1
  bannerVisible.value = true
}

function getBannerOffset(index: number) {
  const total = bannerList.length
  let diff = index - currentBanner.value
  if (diff > total / 2) diff -= total
  if (diff < -total / 2) diff += total
  return diff
}

function getBannerSlideStyle(index: number) {
  const offset = getBannerOffset(index)
  if (offset === 0) {
    return { transform: 'perspective(1200px) rotateY(0deg) scale(1)', transformOrigin: 'center center', opacity: '1', zIndex: '3' }
  }
  return {
    transform: `perspective(1200px) rotateY(${offset < 0 ? -34 : 34}deg) scale(0.92)`,
    transformOrigin: offset < 0 ? 'right center' : 'left center', opacity: '0.9', zIndex: '1',
  }
}

function handleQuickCardClick(item: any) {
  if (item.routeType === 'switch') {
    uni.switchTab({ url: item.route })
    return
  }
  uni.navigateTo({ url: item.route })
}

function formatTime(value: string) {
  if (!value) return ''
  const date = new Date(value.replace(/-/g, '/'))
  const diff = Date.now() - date.getTime()
  const hour = 60 * 60 * 1000
  if (diff >= 0 && diff < hour) return '刚刚'
  if (diff >= hour && diff < 24 * hour) return `${Math.floor(diff / hour)}小时前`
  if (diff >= 24 * hour && diff < 48 * hour) return '昨天'
  return `${date.getMonth() + 1}/${date.getDate()}`
}

function senderName(item: PlazaMessage) {
  return item.isAnonymous ? '匿名用户' : item.senderSignature || '暖心用户'
}

function avatarText(item: PlazaMessage) {
  return senderName(item).slice(0, 1)
}

async function loadHomeData() {
  try {
    // 公开故事不依赖登录态，先独立加载，避免个人动态请求失败时一起被丢弃。
    const storyResult = await getPublicMessageList(1, 4)
    stories.value = (storyResult.list || []).slice(0, 4)
  } catch (err) {
    stories.value = []
  }

  // 最近动态是用户数据，H5 未登录时不发起该请求。
  if (!user.token) {
    recentActivity.value = { sentCount: 0, replyCount: 0, deliveredCount: 0, date: '' }
    return
  }

  try {
    recentActivity.value = await getRecentActivity()
  }
  catch (err) {
    // 个人动态加载失败不影响公开故事展示。
  }
}

async function initializeHome() {
  if (homeInitializing || homeInitialized.value)
    return

  homeInitializing = true
  try {
    await initializeUser()
    await loadHomeData()
    homeInitialized.value = true
  }
  finally {
    homeInitializing = false
  }
}

function goPlaza() {
  uni.switchTab({ url: '/pages/plaza' })
}

onLoad(initializeHome)
onShow(() => {
  resetBanner()
  // 首次展示由 onLoad 串行初始化，之后切回首页时再刷新数据。
  if (homeInitialized.value)
    loadHomeData()
})
onHide(() => {
  bannerVisible.value = false
  currentBanner.value = 0
})
</script>

<template>
  <view class="home-page min-h-[100vh] overflow-hidden pb-[42rpx] text-[#5a3328]">
    <cl-topbar :showBack="false" safeAreaTop backgroundColor="#fff8f7" color="#7a5147" height="100rpx">
      <view class="flex flex-row items-center justify-center gap-[12rpx]">
        <image :src="mergeOssPath('logo-heart.png')" mode="aspectFit" class="h-[76rpx] w-[76rpx]" />
        <text class="text-[40rpx] text-[#7a5147] font-[800] tracking-[2rpx]">心语代传</text>
      </view>
    </cl-topbar>

    <view class="px-[28rpx]">
      <view class="mt-[12rpx] h-[82rpx] flex flex-row items-center rounded-[22rpx] border border-solid border-[#f8dcc7] bg-[#fff5e8] px-[22rpx]">
        <image :src="mergeOssPath('safe.png')" mode="aspectFit" class="h-[43rpx] w-[43rpx]" />
        <text class="ml-[18rpx] text-[27rpx] text-[#6e3c2a] font-[700] flex-1">每一次善意的表达，都可能温暖一个人 💛</text>
      </view>
    </view>

    <view class="banner-swiper-wrap mt-[20rpx] overflow-visible">
      <swiper v-if="bannerVisible" :key="bannerKey" class="banner-swiper h-[304rpx] w-full" :current="currentBanner" :autoplay="true" :interval="3200" :circular="true" previous-margin="80rpx" next-margin="80rpx" @change="onBannerChange">
        <swiper-item v-for="(item, index) in bannerList" :key="item.image" class="banner-swiper-item">
          <view class="px-[4px] overflow-visible">
            <view class="banner-slide relative box-border h-[280rpx] w-full overflow-hidden border-[6rpx] border-white rounded-[28rpx] border-solid" :style="getBannerSlideStyle(index)">
              <image :src="item.image" mode="scaleToFill" class="absolute inset-[0rpx] h-full w-full" />
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>
    <view class="mt-[14rpx] flex flex-row justify-center gap-[10rpx]">
      <view v-for="(_, index) in bannerList" :key="index" class="h-[12rpx] rounded-[12rpx]" :class="index === currentBanner ? 'w-[28rpx] bg-[#ff8874]' : 'w-[12rpx] bg-[#e9ddd8]'" />
    </view>

    <view class="mt-[22rpx] flex flex-row gap-[14rpx] px-[28rpx]">
      <view v-for="item in quickCards" :key="item.title" class="quick-card relative h-[220rpx] flex-1 overflow-hidden rounded-[24rpx] px-[28rpx] pt-[34rpx]" :class="item.cardClass" @click="handleQuickCardClick(item)">
        <text class="relative z-[1] block text-[30rpx] text-[#603628] font-[800]">{{ item.title }}</text>
        <text class="relative z-[1] mt-[10rpx] block text-[22rpx] text-[#70483b]">{{ item.desc }}</text>
        <view class="relative z-[1] mt-[30rpx] h-[36rpx] w-[36rpx] flex flex-row items-center justify-center rounded-full" :class="item.arrowClass"><cl-icon name="arrow-right-s-line" :size="12" :pt="{ className: 'text-white' }" /></view>
        <image :src="item.image" mode="scaleToFill" class="quick-card-image absolute top-0 left-0 w-full h-full" />
      </view>
    </view>

    <view class="mt-[42rpx] px-[40rpx] overflow-visible">
      <text class="text-[31rpx] text-[#553228] font-[800]">最近动态</text>
      <view class="activity-line relative mt-[10rpx] flex flex-row justify-between gap-[14rpx] py-[10rpx]">
        <view v-for="item in activityCards" :key="item.key" class="activity-card relative z-[1] box-border h-[140rpx] min-w-0 flex-1 rounded-[22rpx] bg-white px-[14rpx] py-[18rpx] border border-solid border-[#fef5f3]">
          <image :src="item.image" mode="aspectFit" class="absolute left-[12rpx] top-[26rpx] h-[58rpx] w-[58rpx]" />
          <view class="ml-[66rpx]">
            <text class="block text-[19rpx] text-[#a58a82]">今天</text>
            <text class="mt-[8rpx] block text-[20rpx] text-[#674238]">{{ item.label }}</text>
            <text class="mt-[2rpx] block text-[20rpx] text-[#674238]"><text class="text-[31rpx] text-[#ff7564] font-[800]">{{ recentActivity[item.key] }}</text>{{ item.suffix }}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="mt-[50rpx] px-[40rpx]">
      <view class="flex flex-row items-center justify-between">
        <text class="text-[31rpx] text-[#553228] font-[800]">他们的故事</text>
        <view class="flex flex-row items-center" @click="goPlaza"><text class="text-[22rpx] text-[#86665b]">看看更多温暖故事</text><cl-icon name="arrow-right-s-line" :size="14" :pt="{ className: 'text-[#86665b]' }" /></view>
      </view>
      <view v-if="stories.length" class="mt-[22rpx] grid grid-cols-2 gap-[16rpx]">
        <view v-for="item in stories" :key="item.id" class="story-card min-h-[192rpx] rounded-[22rpx] border border-solid border-[#f9e7df] bg-[#fffefd] p-[20rpx]">
          <view class="flex flex-row items-center"><view class="story-avatar h-[56rpx] w-[56rpx] flex flex-row items-center justify-center rounded-full text-[24rpx] text-white font-[700]">{{ avatarText(item) }}</view><view class="ml-[13rpx] min-w-0 flex-1"><text class="block truncate text-[23rpx] text-[#674237] font-[700]">{{ senderName(item) }}</text><text class="mt-[5rpx] block text-[19rpx] text-[#9c8178]">{{ formatTime(item.createTime) }}</text></view></view>
          <text class="story-content mt-[18rpx] block text-[23rpx] text-[#5d392f] leading-[34rpx]">{{ item.content }}</text>
          <!-- <text class="mt-[16rpx] block text-[20rpx] text-[#ff806e]">♥ 温暖分享</text> -->
        </view>
      </view>
      <view v-else class="mt-[22rpx] rounded-[22rpx] border border-solid border-[#f9e7df] bg-[#fffefd] px-[24rpx] py-[34rpx] text-center"><text class="text-[24rpx] text-[#9b7e74]">温暖故事正在路上</text></view>
    </view>

    <view class="relative mx-[40rpx] mt-[30rpx] overflow-hidden rounded-[24rpx]">
      <image :src="mergeOssPath('home/home-bottom.png')" mode="widthFix" class="w-full" />
    </view>
  </view>
</template>

<style scoped>
.home-page { background: linear-gradient(180deg, #fff8f7 0%, #ffffff 38%, #fffdfc 100%); }
.banner-swiper-wrap, .banner-swiper, .banner-swiper-item { perspective: 1200px; overflow: visible; }
.banner-slide { box-shadow: 0 10rpx 20rpx #d9816220; transition: transform .45s ease, opacity .45s ease; }
.banner-copy { text-shadow: 0 2rpx 10rpx #fff9f7aa; }
.quick-card-heart { background: linear-gradient(135deg, #fff1f4 0%, #fffaf9 100%); }
.quick-card-chat { background: linear-gradient(135deg, #f1fbed 0%, #fbfff9 100%); }
.quick-card-image { z-index: 0; }
.quick-arrow-heart { background: #ff9cac; }
.quick-arrow-chat { background: #9dcf9a; }
.activity-line::before { content: ''; position: absolute; left: 18%; right: 18%; top: 70rpx; border-top: 2rpx dashed #ffd0c8; }
.story-card { box-shadow: 0 8rpx 22rpx #b965480a; }
.story-avatar { background: linear-gradient(145deg, #ffc2ae, #f58f83); }
.story-content { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
</style>
