<script setup lang="ts">
import { ref } from "vue";
import type { UserSetting } from "@/api/setting";
import { getUserSetting, updateUserSetting } from "@/api/setting";

// ---------- 用户设置 ----------
const setting = ref<UserSetting>({
	notifySendResult: 1,
	notifyReply: 1,
	notifyActivity: 1,
	defaultAnonymous: 1,
	blockAllSms: 0
});

onShow(() => {
	fetchSetting();
});

async function fetchSetting() {
	try {
		const data = await getUserSetting();
		setting.value = { ...setting.value, ...data };
	} catch {}
}

async function onToggle(key: keyof UserSetting, val: boolean) {
	const numVal = val ? 1 : 0;
	(setting.value as any)[key] = numVal;
	try {
		await updateUserSetting({ [key]: numVal });
	} catch {
		// 回滚
		(setting.value as any)[key] = val ? 0 : 1;
	}
}

// ---------- 法律文档 ----------
function openDoc(key: string, title: string) {
	uni.navigateTo({
		url: `/package-user/legal-document?key=${encodeURIComponent(key)}&title=${encodeURIComponent(title)}`
	});
}

// ---------- 修改手机号 ----------
function goChangePhone() {
	uni.navigateTo({ url: "/package-user/change-phone" });
}

function goBlacklist() {
	uni.navigateTo({ url: "/package-user/blacklist" });
}

// ---------- 版本号 ----------
const appVersion = ref("1.0.0");
// #ifndef H5
try {
	const info = uni.getSystemInfoSync() as any;
	appVersion.value = info.appVersion || "1.0.0";
} catch {}
// #endif
</script>

<template>
	<view class="min-h-[100vh] bg-[#f7f3f2]">
		<cl-topbar
			title="设置"
			safeAreaTop
			fixed
			backgroundColor="#f7f3f2"
			color="#4a2b24"
			height="88rpx"
			:pt="{
				className: 'shadow-[0_2rpx_12rpx_#59392d0f]',
				title: { className: 'text-[34rpx] font-[800]' },
				back: { size: 20 }
			}"
		/>

		<scroll-view scroll-y class="px-[24rpx] pb-[40rpx]">
			<!-- 隐私设置 -->
			<view class="mt-[24rpx]">
				<text class="mb-[12rpx] block pl-[8rpx] text-[24rpx] text-[#9e7e76]">
					隐私设置
				</text>
				<view
					class="overflow-hidden rounded-[24rpx] bg-[#ffffff] shadow-[0_8rpx_24rpx_#59392d12]"
				>
					<view
						class="flex flex-row h-[100rpx] items-center justify-between border-b-[1rpx] border-b-solid border-b-[#f0e8e4] px-[32rpx]"
						@click="goBlacklist"
					>
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#fff0f1]"
							>
								<cl-icon
									name="user-forbid-line"
									:size="13"
									:pt="{ className: 'text-[#e5484d]' }"
								/>
							</view>
							<view>
								<text class="text-[28rpx] text-[#1a0e0b]">拉黑列表</text>
								<text class="mt-[4rpx] block text-[22rpx] text-[#9e7e76]"
									>管理不能再向你发送短信的用户</text
								>
							</view>
						</view>
						<cl-icon
							name="arrow-right-s-line"
							:size="13"
							:pt="{ className: 'text-[#c4b3ae]' }"
						/>
					</view>
					<view
						class="flex flex-row min-h-[112rpx] items-center justify-between border-b-[1rpx] border-b-solid border-b-[#f0e8e4] px-[32rpx] py-[12rpx]"
					>
						<view class="mr-[24rpx] flex flex-1 flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-shrink-0 flex-row items-center justify-center rounded-[14rpx] bg-[#fff0f1]"
							>
								<cl-icon
									name="notification-off-line"
									:size="13"
									:pt="{ className: 'text-[#e5484d]' }"
								/>
							</view>
							<view class="flex-1">
								<text class="text-[28rpx] text-[#1a0e0b]">屏蔽所有短信</text>
								<text
									class="mt-[4rpx] block text-[22rpx] text-[#9e7e76] leading-[30rpx]"
									>开启后，任何人都不能向你的手机号发送消息</text
								>
							</view>
						</view>
						<cl-switch
							:model-value="!!setting.blockAllSms"
							@change="(value: boolean) => onToggle('blockAllSms', value)"
						/>
					</view>
					<view class="flex flex-row h-[100rpx] items-center justify-between px-[32rpx]">
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#e8f6ff]"
							>
								<cl-icon
									name="user-line"
									:size="13"
									:pt="{ className: 'text-[#3f97f4]' }"
								/>
							</view>
							<view>
								<text class="text-[28rpx] text-[#1a0e0b]">匿名发送默认开启</text>
								<text class="mt-[4rpx] block text-[22rpx] text-[#9e7e76]"
									>发送时默认隐藏真实信息</text
								>
							</view>
						</view>
						<cl-switch
							:model-value="!!setting.defaultAnonymous"
							@change="(value: boolean) => onToggle('defaultAnonymous', value)"
						/>
					</view>
				</view>
			</view>

			<!-- 账号设置 -->
			<view class="mt-[24rpx]">
				<text class="mb-[12rpx] block pl-[8rpx] text-[24rpx] text-[#9e7e76]">
					账号设置
				</text>
				<view
					class="overflow-hidden rounded-[24rpx] bg-[#ffffff] shadow-[0_8rpx_24rpx_#59392d12]"
				>
					<view
						class="flex flex-row h-[100rpx] items-center justify-between px-[32rpx]"
						@click="goChangePhone"
					>
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#e8f6ff]"
							>
								<cl-icon
									name="smartphone-line"
									:size="13"
									:pt="{ className: 'text-[#3f97f4]' }"
								/>
							</view>
							<text class="text-[28rpx] text-[#1a0e0b]">修改手机号</text>
						</view>
						<cl-icon
							name="arrow-right-s-line"
							:size="13"
							:pt="{ className: 'text-[#c4b3ae]' }"
						/>
					</view>
				</view>
			</view>

			<!-- 其他 -->
			<view class="mt-[24rpx]">
				<text class="mb-[12rpx] block pl-[8rpx] text-[24rpx] text-[#9e7e76]"> 其他 </text>
				<view
					class="overflow-hidden rounded-[24rpx] bg-[#ffffff] shadow-[0_8rpx_24rpx_#59392d12]"
				>
					<view
						class="flex flex-row h-[100rpx] items-center justify-between border-b-[1rpx] border-b-solid border-b-[#f0e8e4] px-[32rpx]"
						@click="openDoc('user_agreement', '用户协议')"
					>
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#f4eeff]"
							>
								<cl-icon
									name="file-paper-line"
									:size="13"
									:pt="{ className: 'text-[#8d68ee]' }"
								/>
							</view>
							<text class="text-[28rpx] text-[#1a0e0b]">用户协议</text>
						</view>
						<cl-icon
							name="arrow-right-s-line"
							:size="13"
							:pt="{ className: 'text-[#c4b3ae]' }"
						/>
					</view>
					<view
						class="flex flex-row h-[100rpx] items-center justify-between border-b-[1rpx] border-b-solid border-b-[#f0e8e4] px-[32rpx]"
						@click="openDoc('privacy_policy', '隐私政策')"
					>
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#f4eeff]"
							>
								<cl-icon
									name="shield-check-line"
									:size="13"
									:pt="{ className: 'text-[#8d68ee]' }"
								/>
							</view>
							<text class="text-[28rpx] text-[#1a0e0b]">隐私政策</text>
						</view>
						<cl-icon
							name="arrow-right-s-line"
							:size="13"
							:pt="{ className: 'text-[#c4b3ae]' }"
						/>
					</view>
					<view
						class="flex flex-row h-[100rpx] items-center justify-between border-b-[1rpx] border-b-solid border-b-[#f0e8e4] px-[32rpx]"
						@click="openDoc('refund_rules', '退款规则')"
					>
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#f4eeff]"
							>
								<cl-icon
									name="refund-line"
									:size="13"
									:pt="{ className: 'text-[#8d68ee]' }"
								/>
							</view>
							<text class="text-[28rpx] text-[#1a0e0b]">退款规则</text>
						</view>
						<cl-icon
							name="arrow-right-s-line"
							:size="13"
							:pt="{ className: 'text-[#c4b3ae]' }"
						/>
					</view>
					<view class="flex flex-row h-[100rpx] items-center justify-between px-[32rpx]">
						<view class="flex flex-row items-center gap-[18rpx]">
							<view
								class="h-[48rpx] w-[48rpx] flex flex-row items-center justify-center rounded-[14rpx] bg-[#e8f6ff]"
							>
								<cl-icon
									name="information-2-line"
									:size="13"
									:pt="{ className: 'text-[#3f97f4]' }"
								/>
							</view>
							<text class="text-[28rpx] text-[#1a0e0b]">当前版本</text>
						</view>
						<text class="text-[24rpx] text-[#c4b3ae]">v{{ appVersion }}</text>
					</view>
				</view>
			</view>

			<view class="h-[60rpx]" />
		</scroll-view>
	</view>
</template>
