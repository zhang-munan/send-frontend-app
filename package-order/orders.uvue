<script setup lang="ts">
import { computed, onMounted, ref } from "vue";
import { getBalance, getOrderList, type OrderInfo, type UserBalance } from '@/api/order'

type BillType = 'all' | 'recharge' | 'consume' | 'refund'

interface BillItem extends OrderInfo {
  billType: Exclude<BillType, 'all'>
  amountText: string
  amountColor: string
  iconBg: string
  displayName: string
  displayTime: string
}

interface MonthGroup {
  key: string
  title: string
  total: number
  totalText: string
  totalColor: string
  items: BillItem[]
}

const list = ref<OrderInfo[]>([])
const balance = ref<UserBalance | null>(null)
const total = ref(0)
const page = ref(1)
const pageSize = 20
const loading = ref(false)
const noMore = ref(false)
const activeType = ref<BillType>('all')
const periodLabel = ref('近30天')

const tabs: { label: string, value: BillType }[] = [
  { label: '全部', value: 'all' },
  { label: '充值', value: 'recharge' },
  { label: '消费', value: 'consume' },
  { label: '退款', value: 'refund' },
]

const paidOrders = computed(() => list.value.filter(order => order.status === 1 || order.status === 2))
const billItems = computed(() => paidOrders.value.map(toBillItem))
const filteredItems = computed(() => {
  if (activeType.value === 'all')
    return billItems.value
  return billItems.value.filter(item => item.billType === activeType.value)
})

const currentMonthKey = computed(() => formatMonthKey(new Date()))
const monthRecharge = computed(() =>
  sumByType(billItems.value, 'recharge', currentMonthKey.value),
)
const monthConsume = computed(() =>
  Math.abs(sumByType(billItems.value, 'consume', currentMonthKey.value)),
)
const monthGroups = computed<MonthGroup[]>(() => {
  const groups = new Map<string, BillItem[]>()
  filteredItems.value.forEach((item) => {
    const key = getMonthKey(item.createTime)
    if (!groups.has(key))
      groups.set(key, [])
    groups.get(key)!.push(item)
  })

  return Array.from(groups.entries()).map(([key, items]) => {
    const totalAmount = items.reduce((sum, item) => sum + getSignedAmount(item), 0)
    return {
      key,
      title: formatMonthTitle(key),
      total: totalAmount,
      totalText: `${totalAmount >= 0 ? '+' : '-'}¥${Math.abs(totalAmount).toFixed(2)}`,
      totalColor: totalAmount >= 0 ? '#13bf56' : '#ff3d46',
      items,
    }
  })
})

async function loadList(reset = false) {
  if (loading.value)
    return
  if (!reset && noMore.value)
    return

  if (reset) {
    page.value = 1
    noMore.value = false
    list.value = []
  }

  loading.value = true
  try {
    const [ordersRes, balanceRes] = await Promise.all([
      getOrderList(page.value, pageSize),
      reset ? getBalance().catch(() => null) : Promise.resolve(balance.value),
    ])
    if (reset) {
      list.value = ordersRes.list
      balance.value = balanceRes
    }
    else {
      list.value.push(...ordersRes.list)
    }
    total.value = ordersRes.total
    if (list.value.length >= ordersRes.total)
      noMore.value = true
    page.value++
  }
  catch (err: any) {
    uni.showToast({ title: err?.message || '加载失败', icon: 'none' })
  }
  finally {
    loading.value = false
  }
}

onMounted(() => loadList(true))

function goRecharge() {
  uni.navigateTo({ url: '/package-order/recharge' })
}

function showFilter() {
  uni.showToast({ title: '当前显示近30天账单', icon: 'none' })
}

function setActiveType(type: BillType) {
  activeType.value = type
}

function isBalanceRechargeOrder(order: OrderInfo) {
  return !order.productId && Boolean(order.productName?.includes('余额充值'))
}

function isPackageOrder(order: OrderInfo) {
  return Boolean(order.productId)
}

function toBillItem(order: OrderInfo): BillItem {
  const amount = Number(order.payAmount || 0)
  const isRefund = order.status === 2
  const billType: BillItem['billType'] = isRefund
    ? 'refund'
    : isBalanceRechargeOrder(order) ? 'recharge' : 'consume'
  const signedAmount = billType === 'consume' ? -amount : amount
  const displayName = billType === 'recharge'
    ? `余额充值 - ${order.productName || '账户余额'}`
    : billType === 'refund'
      ? `退款 - ${order.productName || '发送失败返还'}`
      : isPackageOrder(order)
        ? `套餐购买 - ${order.productName || '消息包'}`
      : `${order.productName || '发送消息'} x${order.quantity || 1}`

  return {
    ...order,
    billType,
    displayName,
    displayTime: formatItemTime(order.createTime),
    amountText: `${signedAmount >= 0 ? '+' : '-'}¥${Math.abs(signedAmount).toFixed(2)}`,
    amountColor: billType === 'recharge' ? '#13bf56' : billType === 'refund' ? '#288bf2' : '#ff3d46',
    iconBg: billType === 'recharge'
      ? 'background: linear-gradient(135deg, #dcffe6, #c8f5d3);'
      : billType === 'refund'
        ? 'background: linear-gradient(135deg, #e4f1ff, #d8eaff);'
        : 'background: linear-gradient(135deg, #ffe9e8, #ffd9d5);',
  }
}

function getSignedAmount(item: BillItem) {
  const amount = Number(item.payAmount || 0)
  return item.billType === 'consume' ? -amount : amount
}

function sumByType(items: BillItem[], type: BillItem['billType'], monthKey: string) {
  return items
    .filter(item => item.billType === type && getMonthKey(item.createTime) === monthKey)
    .reduce((sum, item) => sum + getSignedAmount(item), 0)
}

function parseDate(time: string) {
  return time ? new Date(time.replace(/-/g, '/').replace('T', ' ')) : new Date()
}

function getMonthKey(time: string) {
  return formatMonthKey(parseDate(time))
}

function formatMonthKey(date: Date) {
  const month = `${date.getMonth() + 1}`.padStart(2, '0')
  return `${date.getFullYear()}-${month}`
}

function formatMonthTitle(key: string) {
  const [year, month] = key.split('-')
  return `${year}年${Number(month)}月`
}

function formatItemTime(time: string) {
  if (!time)
    return '-'
  const date = parseDate(time)
  const month = `${date.getMonth() + 1}`.padStart(2, '0')
  const day = `${date.getDate()}`.padStart(2, '0')
  const hour = `${date.getHours()}`.padStart(2, '0')
  const minute = `${date.getMinutes()}`.padStart(2, '0')
  return `${month}-${day} ${hour}:${minute}`
}
</script>

<template>
  <view class="min-h-[100vh] bg-[#fff8f6] text-[#4a2b24]">
    <cl-topbar
      title="账单明细"
      safeAreaTop
	  fixed
      backgroundColor="#fff8f6"
      color="#4a2b24"
      height="88rpx"
      :pt="{ title: { className: 'text-[34rpx] font-[800]' }, back: { size: 20 } }"
    >
      <template #append>
        <view class="mr-[24rpx] h-[72rpx] flex flex-row items-center gap-[8rpx]" @click="showFilter">
          <cl-icon name="filter-line" :size="17" :pt="{ className: 'text-[#4a2b24]' }" />
          <text class="text-[26rpx] text-[#4a2b24]">
            筛选
          </text>
        </view>
      </template>
    </cl-topbar>

    <scroll-view
      scroll-y
      class="h-[calc(100vh-104rpx)] px-[28rpx] pb-[48rpx]"
      @scrolltolower="loadList(false)"
    >
      <!-- summary card -->
      <view
        class="relative mt-[6rpx] overflow-hidden rounded-[26rpx] px-[22rpx] py-[34rpx]"
        style="background: linear-gradient(118deg, #ffe0bd, #fff3e6, #ffddcb); border: 1rpx solid #ffffffd9; box-shadow: 0 12rpx 34rpx #ff9a7f21;"
      >
        <view class="pointer-events-none absolute right-[18rpx] top-[24rpx] h-[144rpx] w-[144rpx] rounded-full bg-[#ffffff4d]" />
        <view class="relative z-1 flex flex-row items-center">
          <view class="flex-1 items-center text-center">
            <text class="block text-[28rpx] text-[#5c352c]">
              账户余额
            </text>
            <text class="mt-[20rpx] block text-[46rpx] text-[#ff5a63] leading-[54rpx] font-[900]">
              ¥ {{ balance ? Number(balance.balance).toFixed(2) : '0.00' }}
            </text>
            <view class="mt-[16rpx] inline-flex flex-row border border-[#ff8d8f] rounded-[32rpx] border-solid px-[24rpx] py-[7rpx]" @click="goRecharge">
              <text class="text-[24rpx] text-[#ff515c]">
                去充值
              </text>
            </view>
          </view>

          <view class="mx-[18rpx] h-[76rpx] w-[2rpx] bg-[#ffffffe0]" />

          <view class="flex-1 items-center text-center">
            <text class="block text-[28rpx] text-[#5c352c]">
              本月消费
            </text>
            <text class="mt-[20rpx] block text-[46rpx] text-[#ff5a63] leading-[54rpx] font-[900]">
              ¥ {{ monthConsume.toFixed(2) }}
            </text>
            <view class="mt-[15rpx] inline-flex flex-row items-center gap-[6rpx]">
              <text class="text-[24rpx] text-[#5c352c]">
                明细
              </text>
              <cl-icon name="arrow-right-s-line" :size="12" :pt="{ className: 'text-[#5c352c]' }" />
            </view>
          </view>

          <view class="mx-[18rpx] h-[76rpx] w-[2rpx] bg-[#ffffffe0]" />

          <view class="flex-1 items-center text-center">
            <text class="block text-[28rpx] text-[#5c352c]">
              本月充值
            </text>
            <text class="mt-[20rpx] block text-[46rpx] text-[#ff5a63] leading-[54rpx] font-[900]">
              ¥ {{ monthRecharge.toFixed(2) }}
            </text>
            <view class="mt-[15rpx] inline-flex flex-row items-center gap-[6rpx]">
              <text class="text-[24rpx] text-[#5c352c]">
                明细
              </text>
              <cl-icon name="arrow-right-s-line" :size="12" :pt="{ className: 'text-[#5c352c]' }" />
            </view>
          </view>
        </view>
      </view>

      <!-- filters -->
      <view class="mt-[32rpx] flex flex-row items-center justify-between">
        <view class="flex flex-row items-center gap-[28rpx]">
          <view
            v-for="tab in tabs"
            :key="tab.value"
            class="h-[58rpx] min-w-[98rpx] flex flex-row items-center justify-center px-[20rpx]"
            :class="activeType === tab.value ? 'rounded-[32rpx] bg-[#ffd6d8]' : ''"
            @click="setActiveType(tab.value)"
          >
            <text
              class="text-[28rpx]"
              :class="activeType === tab.value ? 'font-[700] text-[#ff4c54]' : 'text-[#6d6260]'"
            >
              {{ tab.label }}
            </text>
          </view>
        </view>
        <view
          class="h-[58rpx] flex flex-row items-center gap-[10rpx] border border-[#ddd0cb] rounded-[32rpx] border-solid bg-[#ffffffa3] px-[22rpx]"
          @click="showFilter"
        >
          <cl-icon name="calendar-line" :size="14" :pt="{ className: 'text-[#827570]' }" />
          <text class="text-[26rpx] text-[#827570]">
            {{ periodLabel }}
          </text>
          <cl-icon name="arrow-down-s-line" :size="12" :pt="{ className: 'text-[#827570]' }" />
        </view>
      </view>

      <!-- empty state -->
      <view v-if="!loading && monthGroups.length === 0" class="flex flex-col items-center justify-center py-[150rpx]">
        <cl-icon name="bill-line" :size="44" :pt="{ className: 'text-[#f0c9c2]' }" />
        <text class="mt-[18rpx] text-[28rpx] text-[#a08a84]">
          暂无账单记录
        </text>
        <view class="mt-[34rpx] rounded-[32rpx] bg-[#fe8973] px-[48rpx] py-[16rpx]" @click="goRecharge">
          <text class="text-[28rpx] text-white font-[700]">
            去充值
          </text>
        </view>
      </view>

      <!-- grouped list -->
      <view
        v-for="group in monthGroups"
        :key="group.key"
        class="mt-[28rpx] overflow-hidden rounded-[24rpx] bg-white px-[28rpx] pt-[28rpx]"
        style="box-shadow: 0 8rpx 28rpx #5e39300f;"
      >
        <view class="mb-[14rpx] flex flex-row items-center justify-between">
          <text class="text-[34rpx] text-[#4a2b24] tracking-[4rpx] font-[800]">
            {{ group.title }}
          </text>
          <view class="flex flex-row items-baseline gap-[10rpx]">
            <text class="text-[26rpx] text-[#6b4c45]">
              当月合计
            </text>
            <text class="text-[27rpx] font-[800]" :style="{ color: group.totalColor }">
              {{ group.totalText }}
            </text>
          </view>
        </view>

        <view
          v-for="(item, index) in group.items"
          :key="item.id"
          class="flex flex-row items-center py-[22rpx]"
          :class="index < group.items.length - 1 ? 'border-b border-b-solid border-b-[#f2e8e5]' : ''"
        >
          <view
            class="h-[78rpx] w-[78rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-full"
            :style="item.iconBg"
          >
            <cl-icon v-if="item.billType === 'recharge'" name="line-chart-line" :size="21" :pt="{ className: 'text-[#26bd58]' }" />
            <cl-icon v-else-if="item.billType === 'refund'" name="refund-line" :size="21" :pt="{ className: 'text-[#288bf2]' }" />
            <cl-icon v-else name="arrow-right-down-line" :size="21" :pt="{ className: 'text-[#ff4f59]' }" />
          </view>
          <view class="ml-[24rpx] min-w-0 flex-1">
            <text class="block truncate text-[30rpx] text-[#1f1715] leading-[38rpx] font-[600]">
              {{ item.displayName }}
            </text>
            <text class="mt-[8rpx] block truncate text-[24rpx] text-[#7e7674] leading-[30rpx]">
              {{ item.displayTime }} · 订单号 {{ item.orderNo }}
            </text>
          </view>
          <text class="ml-[16rpx] w-[150rpx] text-right text-[31rpx] font-[900]" :style="{ color: item.amountColor }">
            {{ item.amountText }}
          </text>
          <cl-icon name="arrow-right-s-line" :size="15" :pt="{ className: 'ml-[12rpx] flex-shrink-0 text-[#8d8581]' }" />
        </view>
      </view>

      <view class="py-[36rpx] text-center">
        <text v-if="loading" class="text-[24rpx] text-[#c4b3ae]">
          加载中...
        </text>
        <view v-else-if="noMore && monthGroups.length > 0" class="inline-flex flex-row items-center gap-[18rpx]">
          <view class="h-[1rpx] w-[72rpx] bg-[#d8ccc8]" />
          <text class="text-[24rpx] text-[#938784]">
            上拉加载更多
          </text>
          <view class="h-[1rpx] w-[72rpx] bg-[#d8ccc8]" />
        </view>
      </view>
    </scroll-view>
  </view>
</template>
