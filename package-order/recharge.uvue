<script setup lang="ts">
import { computed, onMounted, ref } from "vue";
import { getProductList, getBalance, createOrder, type ProductInfo, type UserBalance } from '@/api/order'
import { formatYuan, toYuan } from '@/utils/money'

// ─── 数据 ─────────────────────────────────────────────
const products = ref<ProductInfo[]>([])
const userBalance = ref<UserBalance | null>(null)
const selectedId = ref<number | null>(null)
const couponCode = ref('')
const couponDiscount = ref(0)
const couponApplied = ref(false)
const couponAppliedCode = ref('')
const loading = ref(true)
const paying = ref(false)

// ─── 计算属性 ──────────────────────────────────────────
const selectedProduct = computed(() =>
  products.value.find(p => p.id === selectedId.value) ?? null,
)

const originalTotal = computed(() => {
  if (!selectedProduct.value) return 0
  return Number(selectedProduct.value.sellPrice)
})

const finalTotal = computed(() =>
  Math.max(0, originalTotal.value - couponDiscount.value),
)

const pricePerSms = (p: ProductInfo) => {
  if (!p.messageQuota) return null
  return (toYuan(p.sellPrice) / p.messageQuota).toFixed(2)
}

const savedAmount = (p: ProductInfo) => {
  const saved = Number(p.originalPrice) - Number(p.sellPrice)
  return saved > 0 ? formatYuan(saved) : null
}

// ─── 初始化 ────────────────────────────────────────────
onMounted(async () => {
  try {
    const [list, bal] = await Promise.all([
      getProductList(),
      getBalance().catch(() => null),
    ])
    products.value = list
    userBalance.value = bal
    if (list.length > 0) {
      // 默认选中第一个
      selectedId.value = list[0].id
    }
  }
  finally {
    loading.value = false
  }
})

// ─── 优惠码 ────────────────────────────────────────────
function applyCoupon() {
  if (!couponCode.value.trim()) {
    uni.showToast({ title: '请输入优惠码', icon: 'none' })
    return
  }
  // 模拟优惠码逻辑：SAVE10 立减 1 元（100 分）
  if (couponCode.value.trim().toUpperCase() === 'SAVE10') {
    couponDiscount.value = 100
    couponApplied.value = true
    couponAppliedCode.value = couponCode.value.trim().toUpperCase()
    uni.showToast({ title: '优惠码已使用', icon: 'success' })
  }
  else {
    uni.showToast({ title: '优惠码无效', icon: 'none' })
  }
}

function removeCoupon() {
  couponDiscount.value = 0
  couponApplied.value = false
  couponAppliedCode.value = ''
  couponCode.value = ''
}

// ─── 购买 ──────────────────────────────────────────────
async function handleBuy() {
  if (!selectedProduct.value) {
    uni.showToast({ title: '请选择套餐', icon: 'none' })
    return
  }
  if (paying.value) return
  paying.value = true
  try {
    const order = await createOrder({ productId: selectedProduct.value.id })
    uni.navigateTo({ url: `/package-order/pay?orderId=${order.id}` })
  }
  catch (err: any) {
    uni.showToast({ title: err?.message || '下单失败，请重试', icon: 'none' })
  }
  finally {
    paying.value = false
  }
}

function goOrders() { uni.navigateTo({ url: '/package-order/orders' }) }
</script>

<template>
  <view class="min-h-[100vh] bg-[#fef7f5]">
    <cl-topbar
      title="充值中心"
      safeAreaTop
      fixed
      backgroundColor="#fef7f5"
      color="#4a2b24"
      height="88rpx"
      :pt="{ title: { className: 'text-[34rpx] font-[800]' }, back: { size: 20 } }"
    />

    <!-- 主内容 -->
    <view class="px-[24rpx] pb-[200rpx]">

      <!-- ── 账户余额卡 ── -->
      <view
        class="relative overflow-hidden rounded-[28rpx] px-[32rpx] pt-[36rpx] pb-[40rpx]"
        style="background: #ffaf9b; box-shadow: 0 12rpx 36rpx #ff8c6447;"
      >
        <image
          src="/static/images/order/recharge-banner.png"
          mode="aspectFill"
          class="absolute inset-0 h-full w-full pointer-events-none z-0"
        />
        <!-- 顶部行 -->
        <view class="relative z-[1] flex flex-row items-center justify-between">
          <view class="flex flex-row items-center gap-[10rpx]">
            <cl-icon name="shield-check-line" :size="15" :pt="{ className: 'text-white opacity-90' }" />
            <text class="text-[26rpx] text-white opacity-90">账户余额</text>
          </view>
          <view class="flex flex-row items-center gap-[6rpx]" @click="goOrders">
            <cl-icon name="file-paper-line" :size="12" :pt="{ className: 'text-white opacity-80' }" />
            <text class="text-[24rpx] text-white opacity-80">账单明细</text>
            <cl-icon name="arrow-right-s-line" :size="11" :pt="{ className: 'text-white opacity-80' }" />
          </view>
        </view>

        <!-- 余额金额 -->
        <view class="relative z-[1] mt-[20rpx] flex flex-row items-end gap-[6rpx]">
          <text class="text-[36rpx] font-[700] text-white leading-[56rpx]">¥</text>
          <text class="text-[80rpx] font-[900] text-white leading-[88rpx]">
            {{ userBalance ? formatYuan(userBalance.balance) : '0.00' }}
          </text>
        </view>

        <!-- 剩余条数徽章 -->
        <view
          class="relative z-[1] mt-[16rpx] flex flex-row items-center self-start rounded-[28rpx] bg-[#ffffff4d] px-[20rpx] py-[8rpx]"
          style="align-self: flex-start;"
        >
          <text class="text-[26rpx] font-[700] text-white">
            剩余 {{ userBalance?.messageQuota ?? 0 }} 条
          </text>
        </view>
      </view>

      <!-- ── 套餐选择 ── -->
      <view class="mt-[28rpx]">
        <view class="mb-[18rpx] flex flex-row items-center gap-[10rpx]">
          <text class="text-[28rpx]">🔥</text>
          <text class="text-[30rpx] font-[800] text-[#4a2b24]">选择套餐</text>
        </view>

        <!-- 骨架 -->
        <view v-if="loading" class="flex flex-col gap-[16rpx]">
          <view
            v-for="i in 3"
            :key="i"
            class="h-[120rpx] rounded-[20rpx] bg-[#f5ece9] animate-pulse"
          />
        </view>

        <!-- 套餐列表 -->
        <view v-else class="flex flex-col gap-[10rpx]">
          <view
            v-for="p in products"
            :key="p.id"
            class="relative overflow-hidden rounded-[20rpx] bg-white px-[24rpx] py-[24rpx]"
            :style="selectedId === p.id
              ? 'border: 2rpx solid #fe8973; box-shadow: 0 4rpx 20rpx #fe89732e; background: #fff5f3;'
              : 'border: 2rpx solid transparent; box-shadow: 0 2rpx 12rpx #59392d0f;'"
            @click="selectedId = p.id"
          >
            <!-- 角标 -->
            <view
              v-if="p.tagContent"
              class="absolute left-[0rpx] top-[0rpx] rounded-br-[20rpx] px-[16rpx] py-[4rpx] z-[1]"
              :style="`background:${p.tagBackgroundColor || '#fe8973'};`"
            >
              <text class="text-[20rpx] font-[700] text-white">
                {{ p.tagContent }}
              </text>
            </view>

            <view class="flex flex-row items-center gap-[20rpx]">
              <!-- 套餐头像：使用商品数据返回的封面头像 -->
              <view
                class="h-[88rpx] w-[88rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-[20rpx]"
                style="background: linear-gradient(135deg, #ffd8c8, #ffb8a8);"
              >
                <image
                  v-if="p.coverImage"
                  :src="p.coverImage"
                  mode="aspectFill"
                  class="h-full w-full rounded-[20rpx]"
                />
                <text v-else class="text-[46rpx]">🎁</text>
              </view>

              <!-- 名称区域 -->
              <view class="min-w-0 flex-1">
                <text class="block text-[30rpx] font-[800] text-[#4a2b24]">{{ p.name }}</text>
                <text
                  v-if="p.subtitle"
                  class="mt-[4rpx] block text-[22rpx] text-[#a08a84]"
                >
                  {{ p.subtitle }}
                </text>
              </view>

              <!-- 条数 -->
              <view class="flex-shrink-0 text-center flex-row items-baseline justify-center gap-[4rpx]">
                <text
                  class="text-[42rpx] font-[900]"
                  :class="selectedId === p.id ? 'text-[#fe8973]' : 'text-[#4a2b24]'"
                >
                  {{ p.messageQuota }}
                </text>
                <text class="text-[24rpx] text-[#a08a84]"> 条</text>
              </view>

              <!-- 价格区域 -->
              <view class="flex-shrink-0 text-right w-[180rpx]">
                <text class="block text-[34rpx] font-[800] text-[#4a2b24]">
                  ¥{{ formatYuan(p.sellPrice) }}
                </text>
                <view class="mt-[2rpx] flex flex-row items-center justify-end gap-[12rpx]">
                  <text v-if="pricePerSms(p)" class="text-[20rpx] text-[#a08a84]">
                    ¥{{ pricePerSms(p) }}/条
                  </text>
                  <text v-if="savedAmount(p)" class="text-[20rpx] font-[600] text-[#fe8973]">
                    省¥{{ savedAmount(p) }}
                  </text>
                </view>
              </view>

              <!-- 单选圈 -->
              <!-- <view class="ml-[4rpx] flex-shrink-0">
                <view
                  v-if="selectedId === p.id"
                  class="h-[44rpx] w-[44rpx] flex flex-row items-center justify-center rounded-full bg-[#fe8973]"
                >
                  <cl-icon name="check-line" :size="12" :pt="{ className: 'text-white' }" />
                </view>
                <view
                  v-else
                  class="h-[44rpx] w-[44rpx] rounded-full border-[1px] border-solid border-[#d8c8c4]"
                />
              </view> -->
            </view>
          </view>
        </view>
      </view>

      <!-- ── 优惠码 ── -->
      <!-- <view class="mt-[28rpx]">
        <view class="mb-[16rpx] flex flex-row items-center gap-[10rpx]">
          <text class="text-[26rpx]">🏷️</text>
          <text class="text-[28rpx] font-[800] text-[#4a2b24]">优惠码</text>
        </view>

        <view class="flex flex-row items-center gap-[16rpx] rounded-[18rpx] bg-white px-[24rpx] py-[16rpx]" style="box-shadow: 0 2rpx 12rpx #59392d0f;">
          <input
            v-model="couponCode"
            :disabled="couponApplied"
            placeholder="输入优惠码"
            placeholder-style="color: #c4b3ae;"
            class="min-w-0 flex-1 h-[56rpx] text-[28rpx] text-[#4a2b24]"
          />
          <view
            class="h-[64rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-[14rpx] px-[28rpx]"
            :class="couponApplied ? 'bg-[#f0f0f0]' : 'bg-[#fe8973]'"
            @click="!couponApplied && applyCoupon()"
          >
            <text class="text-[26rpx] font-[700]" :class="couponApplied ? 'text-[#b0b0b0]' : 'text-white'">
              使用
            </text>
          </view>
        </view>

        <view
          v-if="couponApplied"
          class="mt-[14rpx] flex flex-row items-center gap-[12rpx] rounded-[14rpx] bg-[#f0fff4] px-[20rpx] py-[14rpx]"
          style="border: 1rpx solid #b7ebc3;"
        >
          <cl-icon name="checkbox-circle-fill" :size="15" :pt="{ className: 'flex-shrink-0 text-[#4caf50]' }" />
          <text class="min-w-0 flex-1 text-[24rpx] text-[#2e7d32]">
            已使用优惠码 {{ couponAppliedCode }}，立减 ¥{{ formatYuan(couponDiscount) }}
          </text>
          <cl-icon @click="removeCoupon" name="close-line" :size="13" :pt="{ className: 'flex-shrink-0 text-[#a0a0a0]' }" />
        </view>
      </view> -->

    </view>

    <!-- ── 底部购买栏 ── -->
    <view
      class="fixed bottom-0 left-0 right-0 border-t border-t-solid border-t-[#f0e8e4] bg-white px-[24rpx] pb-[48rpx] pt-[20rpx]"
    >
      <view class="flex flex-row items-center justify-between gap-[20rpx]">
        <!-- 左侧：合计 + 优惠信息 -->
        <view class="flex flex-col flex-shrink-0 justify-center">
          <view class="flex flex-row items-baseline gap-[4rpx]">
            <text class="text-[26rpx] text-[#7a5147]">合计：</text>
            <text class="text-[26rpx] font-[700] text-[#fe8973]">¥</text>
            <text class="text-[48rpx] font-[900] leading-[52rpx] text-[#fe8973]">
              {{ formatYuan(finalTotal) }}
            </text>
          </view>
          <view v-if="couponApplied" class="mt-[4rpx] flex flex-row items-center gap-[6rpx]">
            <text class="text-[22rpx] text-[#a08a84]">已优惠</text>
            <text class="text-[22rpx] font-[600] text-[#fe8973]">¥{{ formatYuan(couponDiscount) }}</text>
            <text class="text-[22rpx] text-[#c4b3ae]">，明细</text>
            <cl-icon name="arrow-down-s-line" :size="10" :pt="{ className: 'text-[#a08a84]' }" />
          </view>
        </view>

        <!-- 购买按钮 -->
        <view
          class="h-[88rpx] w-[340rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-[22rpx]"
          :class="paying || !selectedProduct ? 'bg-[#fbb9ad]' : 'bg-[#fe8973]'"
          style="box-shadow: 0 8rpx 24rpx #fe89735c;"
          @click="handleBuy"
        >
          <text class="text-[32rpx] font-[800] text-white">
            {{ paying ? '处理中...' : '立即购买' }}
          </text>
        </view>
      </view>
    </view>
  </view>
</template>
