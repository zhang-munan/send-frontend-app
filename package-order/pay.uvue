<script setup lang="ts">
import { computed, onMounted, ref } from "vue";
import type { OrderInfo, ProductInfo, WxPayParams } from "@/api/order";
import { getBalance, getOrderDetail, getProductDetail, payOrder, queryOrderStatus } from "@/api/order";
import { isDev } from "@/config";
import { formatYuan } from '@/utils/money'
import { mergeOssPath } from '@/utils/oss'

// ─── 路由参数 ────────────────────────────────────────────────
const pages = getCurrentPages();
const currentPage = pages[pages.length - 1] as any;
const orderId = computed<number>(() => Number(currentPage?.options?.orderId || 0));

// ─── 状态 ────────────────────────────────────────────────────
type PaymentType = "wechat" | "alipay" | "balance" | "mock";
interface PaymentMethod {
	id: PaymentType;
	name: string;
	tag: string;
	disabled: boolean;
	disabledTip?: string;
	iconBg: string;
	iconText: string;
	iconImage?: string;
}

const selectedPayment = ref<PaymentType>("wechat");
const orderInfo = ref<OrderInfo | null>(null);
const productInfo = ref<ProductInfo | null>(null);
const userBalance = ref(0);
const userQuota = ref(0);
const loading = ref(true);
const paying = ref(false);

const productCoverImage = computed(() => productInfo.value?.coverImage || mergeOssPath('order', 'payment-gift.png'));

// ─── 支付方式列表 ─────────────────────────────────────────────
const paymentMethods = computed(() => {
	const methods: PaymentMethod[] = [
		{
			id: "wechat",
			name: "微信支付",
			tag: "",
			disabled: false,
			iconBg: "#07c160",
			iconText: "微",
			iconImage: mergeOssPath('order', 'payment-wechat.png')
		},
		{
			id: "alipay",
			name: "支付宝支付",
			tag: "H5端支持",
			disabled: false,
			iconBg: "#1677ff",
			iconText: "支",
			iconImage: mergeOssPath('order', 'payment-alipay.png')
		},
		{
			id: "balance",
			name: "余额支付",
			tag: "",
			disabled:
				userBalance.value <
				(orderInfo.value ? Number(orderInfo.value.payAmount) : Infinity),
			disabledTip: "余额不足，暂不可用",
			iconBg:
				userBalance.value >= (orderInfo.value ? Number(orderInfo.value.payAmount) : 0)
					? "#a28fdb"
					: "#d0d0d0",
			iconText: "余",
			iconImage: mergeOssPath('order', 'payment-balance.png')
		}
	];

	if (isDev) {
		methods.push({
			id: "mock",
			name: "模拟支付",
			tag: "开发模式",
			disabled: false,
			iconBg: "#10b981",
			iconText: "测"
		});
	}

	return methods;
});

// ─── 初始化 ──────────────────────────────────────────────────
onMounted(async () => {
	await loadData();
});

async function loadData() {
	loading.value = true;
	try {
		const [order, balance] = await Promise.all([
			getOrderDetail(orderId.value),
			getBalance().catch(() => null)
		]);
		orderInfo.value = order;
		if (balance) {
			userBalance.value = Number(balance.balance);
			userQuota.value = balance.messageQuota;
		}
	} catch (err: any) {
		uni.showToast({ title: err?.message || "加载订单失败", icon: "none" });
	} finally {
		loading.value = false;
	}

	// 封面图加载失败或响应缓慢不能影响支付页正常展示。
	if (orderInfo.value?.productId) {
		void loadProductCover(orderInfo.value.productId);
	}
}

async function loadProductCover(productId: number) {
	productInfo.value = await getProductDetail(productId).catch(() => null);
}

// ─── 支付逻辑 ─────────────────────────────────────────────────
const PAY_METHOD_MAP: Record<PaymentType, number> = { wechat: 1, alipay: 2, balance: 3, mock: 4 };

async function handlePay() {
	if (!orderInfo.value) return;
	if (paying.value) return;

	paying.value = true;
	uni.showLoading({ title: "处理中...", mask: true });

	try {
		const payMethodNum = PAY_METHOD_MAP[selectedPayment.value];
		const result = await payOrder(orderInfo.value.id, payMethodNum, await getPayParams());

		if (selectedPayment.value === "wechat") {
			// 微信支付：调起收银台
			await invokeWxPay(result as WxPayParams);
			// 轮询等待后端确认
			await waitForPaid(orderInfo.value.id);
		} else if (selectedPayment.value === "balance" || selectedPayment.value === "mock") {
			// 余额支付 / 模拟支付：同步完成
			await onPaySuccess();
		}
	} catch (err: any) {
		uni.hideLoading();
		uni.showToast({ title: err?.message || "支付失败，请重试", icon: "none" });
	} finally {
		paying.value = false;
	}
}

async function getPayParams() {
	if (selectedPayment.value !== "wechat") return undefined;

	// #ifdef MP-WEIXIN
	const code = await new Promise<string>((resolve, reject) => {
		uni.login({
			provider: "weixin",
			success: (res) => resolve(res.code),
			fail: reject
		});
	});
	return { tradeType: "JSAPI" as const, code };
	// #endif

	// #ifdef APP-PLUS
	return { tradeType: "APP" as const };
	// #endif

	// #ifdef H5
	return { tradeType: "H5" as const };
	// #endif

	throw new Error("当前平台暂不支持微信支付");
}

/** 调起微信支付 */
function invokeWxPay(params: WxPayParams): Promise<void> {
	return new Promise((resolve, reject) => {
		// #ifdef H5
		const h5Url = params.h5Url || params.mwebUrl;
		if (h5Url) {
			window.location.href = h5Url;
			resolve();
			return;
		}
		reject(new Error("未获取到微信H5支付链接"));
		return;
		// #endif

		const handlePayFail = (err: any) => {
			if (err?.errMsg?.includes("cancel")) {
				reject(new Error("已取消支付"));
			} else {
				reject(new Error(err?.errMsg || "微信支付失败"));
			}
		};

		// #ifdef APP-PLUS
		if (!params.orderInfo) {
			reject(new Error("微信APP支付参数不完整"));
			return;
		}
		uni.requestPayment({
			provider: "wxpay",
			orderInfo: params.orderInfo,
			success: () => resolve(),
			fail: handlePayFail
		});
		return;
		// #endif

		// #ifdef MP-WEIXIN
		if (
			!params.timeStamp ||
			!params.nonceStr ||
			!params.package ||
			!params.signType ||
			!params.paySign
		) {
			reject(new Error("微信小程序支付参数不完整"));
			return;
		}
		uni.requestPayment({
			provider: "wxpay",
			timeStamp: params.timeStamp,
			nonceStr: params.nonceStr,
			package: params.package,
			signType: params.signType,
			paySign: params.paySign,
			success: () => resolve(),
			fail: handlePayFail
		});
		return;
		// #endif

		reject(new Error("当前平台暂不支持微信支付"));
	});
}

/** 轮询直到后端确认已支付（最多等30秒） */
async function waitForPaid(oId: number, maxRetry = 10, interval = 3000) {
	for (let i = 0; i < maxRetry; i++) {
		await new Promise((r) => setTimeout(r, interval));
		const status = await queryOrderStatus(oId).catch(() => null);
		if (status?.status === 1) {
			await onPaySuccess();
			return;
		}
	}
	uni.hideLoading();
	uni.showToast({ title: "支付结果确认中，请稍后在订单记录查看", icon: "none" });
}

/** 支付成功后跳转 */
async function onPaySuccess() {
	uni.hideLoading();
	uni.showToast({ title: "支付成功！", icon: 'none' });
	setTimeout(() => {
		// 回到首页并刷新
		uni.switchTab({ url: "/pages/index" });
	}, 1500);
}
</script>

<template>
	<view class="min-h-[100vh] bg-[#fef9f7] text-[#4a2b24]">
		<cl-topbar
			title="确认支付"
			safeAreaTop
			fixed
			backgroundColor="#fef9f7"
			color="#4a2b24"
			height="88rpx"
			:pt="{ title: { className: 'text-[34rpx] font-[800]' }, back: { size: 20 } }"
		/>

		<!-- Loading skeleton -->
		<view v-if="loading" class="flex flex-col items-center justify-center py-[120rpx]">
			<cl-icon
				name="loader-4-line"
				:size="30"
				:pt="{ className: 'text-[#fe8973] animate-spin' }"
			/>
			<text class="mt-[20rpx] text-[26rpx] text-[#a08a84]">加载中...</text>
		</view>

		<!-- 订单内容 -->
		<view v-else-if="orderInfo" class="px-[24rpx] pb-[220rpx]">
			<!-- Order and amount card -->
			<view class="rounded-[28rpx] bg-white px-[34rpx] pb-[30rpx] pt-[36rpx]" style="box-shadow: 0 8rpx 30rpx #d78b6d12">
				<view class="flex flex-row items-center gap-[26rpx]">
					<view class="h-[172rpx] w-[172rpx] flex flex-shrink-0 items-center justify-center overflow-hidden rounded-[28rpx] bg-[#fff4ef]">
						<image :src="productCoverImage" mode="aspectFill" class="h-full w-full" />
					</view>
					<view class="min-w-0 flex-1">
						<text class="block text-[34rpx] font-[700] text-[#301712]">{{ orderInfo.productName }}</text>
						<text class="mt-[16rpx] block text-[25rpx] text-[#856d67]">数量：{{ orderInfo.quantity }}</text>
						<text class="mt-[10rpx] block text-[25rpx] text-[#856d67]">订单编号：{{ orderInfo.orderNo }}</text>
						<text class="mt-[10rpx] block text-[25rpx] text-[#856d67]">创建时间：{{ orderInfo.createTime }}</text>
					</view>
				</view>
				<view class="my-[30rpx] border-t border-dashed border-[#f1d9d1]" />
				<view class="flex flex-row items-center justify-between py-[10rpx]">
					<text class="text-[28rpx] text-[#705953]">商品金额：</text>
					<text class="text-[30rpx] font-[600] text-[#27110c]">¥{{ formatYuan(orderInfo.originalPrice) }}</text>
				</view>
				<view v-if="Number(orderInfo.discountAmount) > 0" class="flex flex-row items-center justify-between py-[14rpx]">
					<view class="flex flex-row items-center gap-[12rpx]">
						<text class="text-[28rpx] text-[#705953]">优惠折扣：</text>
						<view class="rounded-[14rpx] bg-[#fff0eb] px-[14rpx] py-[7rpx]">
							<text class="text-[22rpx] text-[#ff6255]">优惠券 - ¥{{ formatYuan(orderInfo.discountAmount) }}</text>
						</view>
					</view>
					<text class="text-[30rpx] font-[600] text-[#ff6255]">- ¥{{ formatYuan(orderInfo.discountAmount) }}</text>
				</view>
				<view class="my-[16rpx] h-[1rpx] bg-[#f5e6e1]" />
				<view class="flex flex-row items-center justify-between pt-[12rpx]">
					<text class="text-[32rpx] font-[700] text-[#301712]">应付金额：</text>
					<text class="text-[58rpx] font-[800] leading-[72rpx] text-[#ff6255]">¥{{ formatYuan(orderInfo.payAmount) }}</text>
				</view>
			</view>

			<!-- Payment method section -->
			<view class="mt-[24rpx] rounded-[28rpx] bg-white px-[26rpx] pb-[22rpx] pt-[32rpx]" style="box-shadow: 0 8rpx 30rpx #d78b6d12">
				<text class="mb-[24rpx] block text-[36rpx] font-[700] text-[#301712]">支付方式</text>

				<view
					v-for="method in paymentMethods"
					:key="method.id"
					class="mb-[16rpx] flex flex-row items-center gap-[20rpx] rounded-[20rpx] border border-solid px-[18rpx] py-[20rpx]"
					:class="[
						method.disabled
							? 'border-[#f1e9e6] bg-[#faf9f8] opacity-50'
							: selectedPayment === method.id
								? 'border-[#ff6b5d] bg-[#fef6f3]'
								: 'border-[#f1e5e0] bg-white'
					]"
					@click="!method.disabled && (selectedPayment = method.id)"
				>
					<view class="h-[62rpx] w-[62rpx] flex flex-row flex-shrink-0 items-center justify-center overflow-hidden rounded-[15rpx]" :style="{ backgroundColor: method.iconBg }">
						<image v-if="method.iconImage" :src="method.iconImage" mode="aspectFit" class="h-full w-full" />
						<text v-else class="text-[32rpx] font-[800] text-white">{{ method.iconText }}</text>
					</view>

					<view class="min-w-0 flex-1">
						<view class="flex flex-row items-center gap-[12rpx]">
							<text
								class="text-[31rpx] font-[600]"
								:class="method.disabled ? 'text-[#b0b0b0]' : 'text-[#4a2b24]'"
							>
								{{ method.name }}
							</text>
							<view
								v-if="method.tag"
								class="rounded-[14rpx] bg-[#fff0eb] px-[12rpx] py-[5rpx]"
							>
								<text class="text-[21rpx] text-[#ff806e]">{{
									method.tag
								}}</text>
							</view>
						</view>
						<text
							v-if="method.disabled && 'disabledTip' in method"
							class="mt-[4rpx] block text-[23rpx] text-[#9f9997]"
						>
							{{ (method as any).disabledTip }}
						</text>
					</view>

					<view class="flex-shrink-0">
						<view
							v-if="!method.disabled && selectedPayment === method.id"
							class="h-[40rpx] w-[40rpx] flex flex-row items-center justify-center rounded-full bg-[#ff6255]"
						>
							<cl-icon
								name="check-line"
								:size="12"
								:pt="{ className: 'text-white' }"
							/>
						</view>
						<view
							v-else-if="!method.disabled"
							class="h-[40rpx] w-[40rpx] rounded-full border-[1px] border-solid border-[#c9bbb6]"
						/>
						<view
							v-else
							class="h-[40rpx] w-[40rpx] flex flex-row items-center justify-center rounded-full border-[1px] border-solid border-[#c9c3c1] bg-transparent"
						>
							<view class="h-[3rpx] w-[26rpx] rotate-45 bg-[#c8c8c8]" />
						</view>
					</view>
				</view>
			</view>

			<!-- Warm tip card -->
			<view class="relative mt-[24rpx] overflow-hidden rounded-[24rpx] border border-solid border-[#ffe1b6] px-[28rpx] py-[22rpx]">
				<image :src="mergeOssPath('order', 'payment-tip-bg.png')" mode="aspectFill" class="absolute inset-0 h-full w-full" />
				<view class="relative z-[1] flex flex-row items-start gap-[14rpx]">
					<image :src="mergeOssPath('safe.png')" mode="aspectFit" class="mt-[2rpx] h-[46rpx] w-[46rpx] flex-shrink-0" />
					<text class="flex-1 text-[26rpx] text-[#8a4a26] leading-[42rpx]">
						温馨提示：支付成功后，消息条数将自动到账，可立即前往表达心意。
					</text>
				</view>
			</view>
		</view>

		<!-- 加载失败 -->
		<view v-else class="flex flex-col items-center justify-center py-[120rpx]">
			<text class="text-[28rpx] text-[#a08a84]">订单加载失败</text>
			<view
				class="mt-[30rpx] rounded-[16rpx] bg-[#fe8973] px-[40rpx] py-[18rpx]"
				@click="loadData"
			>
				<text class="text-[26rpx] font-[600] text-white">重新加载</text>
			</view>
		</view>

		<!-- Fixed bottom action bar -->
		<view
			v-if="orderInfo"
			class="fixed bottom-0 left-0 right-0 border-t border-t-solid border-t-[#f0e8e4] bg-white px-[24rpx] pb-[48rpx] pt-[20rpx]"
		>
			<view class="flex flex-row items-center justify-between gap-[20rpx]">
				<view class="flex flex-col flex-shrink-0">
					<text class="text-[22rpx] text-[#7a5147]">应付金额</text>
					<text class="text-[40rpx] font-[800] leading-[48rpx] text-[#fe8973]">
						¥{{ formatYuan(orderInfo.payAmount) }}
					</text>
				</view>
				<view
					class="h-[88rpx] w-[340rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-[22rpx]"
					:class="paying ? 'bg-[#fbb9ad]' : 'bg-[#fe8973]'"
					style="box-shadow: 0 8rpx 24rpx #fe89735c"
					@click="!paying && handlePay()"
				>
					<text class="text-[32rpx] font-[800] text-white">
						{{ paying ? "支付处理中..." : "确认支付" }}
					</text>
				</view>
			</view>
		</view>
	</view>
</template>
