<script setup lang="ts">
import { computed, onMounted, ref } from "vue";
import { createOrder, getBalance } from '@/api/order'
import { sendMessage } from '@/api/message'
import { getConversationReplyContext, type ConversationReplyContext } from '@/api/conversation'
import { mergeOssPath } from '@/utils/oss'
import { useStore } from '@/.cool'

const { user } = useStore()

const phone = ref('')
const message = ref('')
const isAnonymous = ref(true)
const isPublic = ref(false)
const sendMode = ref<'immediate' | 'scheduled'>('immediate')
const showTemplatePanel = ref(false)
const activeCategory = ref('全部')
const isCreatingOrder = ref(false)
const scheduledDate = ref('')
const scheduledTime = ref('')
const replyConversationId = ref(0)
const replyContext = ref<ConversationReplyContext | null>(null)
const replyContextLoading = ref(false)
const isReplyMode = computed(() => replyConversationId.value > 0)
const pageTitle = computed(() => isReplyMode.value ? '回复消息' : '表达心意')

/** 用户剩余配额 */
const userQuota = ref(0)
/** 是否已加载过余额 */
const balanceLoaded = ref(false)

const MESSAGE_LIMIT = 500

/** 按次支付计费：每 10 字为一条，不足一条按一条计；每条 1.99 元。 */
const SMS_CHARS_PER_SEGMENT = 10
const SMS_FEE_PER_SEGMENT_CENTS = 199
const paidSmsCount = computed(() =>
  Math.max(1, Math.ceil((message.value.length || 0) / SMS_CHARS_PER_SEGMENT))
)
const estimatedFee = computed(() =>
  (paidSmsCount.value * SMS_FEE_PER_SEGMENT_CENTS / 100).toFixed(2)
)

/** 是否有足够套餐配额发送 */
const hasEnoughQuota = computed(() => userQuota.value >= 1)

const minScheduledAt = computed(() => {
  const date = new Date()
  date.setMinutes(date.getMinutes() + 30)
  return date
})

const scheduledAt = computed(() => {
  if (!scheduledDate.value || !scheduledTime.value)
    return ''

  return `${scheduledDate.value} ${scheduledTime.value}:00`
})

const scheduledLabel = computed(() => {
  if (!scheduledAt.value)
    return '请选择发送时间'

  return scheduledAt.value.slice(0, 16)
})

const scheduledTooEarly = computed(() => {
  if (sendMode.value !== 'scheduled' || !scheduledAt.value)
    return false

  return new Date(scheduledAt.value.replace(/-/g, '/')).getTime() < minScheduledAt.value.getTime()
})

onLoad((options) => {
  if (options?.content) {
    message.value = decodeURIComponent(options.content)
    showTemplatePanel.value = false
  }
  const conversationId = Number(options?.replyConversationId || 0)
  if (conversationId > 0) {
    replyConversationId.value = conversationId
    isAnonymous.value = false
    isPublic.value = false
    loadReplyContext()
  }
})

async function loadReplyContext() {
  replyContextLoading.value = true
  try {
    const context = await getConversationReplyContext(replyConversationId.value)
    replyContext.value = context
    phone.value = context.isPeerAnonymous
      ? ''
      : context.receiverPhoneDisplay
  }
  catch (err: any) {
    uni.showToast({ title: err?.message || '无法获取回复对象', icon: 'none' })
  }
  finally {
    replyContextLoading.value = false
  }
}

async function loadBalance() {
	if (!user.info.value?.phone) return
  try {
    const bal = await getBalance()
    userQuota.value = bal.messageQuota
  }
  catch { /* 未登录或接口失败，不影响页面加载 */ }
  finally {
    balanceLoaded.value = true
  }
}

onMounted(loadBalance)
onShow(loadBalance)

function pad(n: number) {
  return n < 10 ? `0${n}` : `${n}`
}

function formatPickerDate(date: Date) {
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`
}

function formatPickerTime(date: Date) {
  return `${pad(date.getHours())}:${pad(date.getMinutes())}`
}

function initScheduledTime() {
  const min = minScheduledAt.value
  if (!scheduledDate.value)
    scheduledDate.value = formatPickerDate(min)
  if (!scheduledTime.value)
    scheduledTime.value = formatPickerTime(min)
}

const categories = ['全部', '道歉和解', '感恩感谢', '表白爱意', '祝福鼓励', '致谢感恩', '温暖关心']

const templates = [
  {
    id: 1,
    title: '真诚道歉',
    preview: '对不起，之前是我太冲动了，没有处理好情绪，冷静之后，我想...',
    tag: '道歉和解',
    emoji: '🌹',
    bgColor: '#ffc8c8',
  },
  {
    id: 2,
    title: '和好如初',
    preview: '影不想因为一时的冲动，影响我们之间的关系，我很珍惜这段关系...',
    tag: '道歉和解',
    emoji: '💕',
    bgColor: '#ffd4e0',
  },
  {
    id: 3,
    title: '温柔关心',
    preview: '最近还好吗？天气转凉了，记得照顾好自己，希望你每天都...',
    tag: '温暖关心',
    emoji: '💐',
    bgColor: '#e8d4f0',
  },
]

const filteredTemplates = computed(() => {
  if (activeCategory.value === '全部')
    return templates
  return templates.filter(t => t.tag === activeCategory.value)
})

function selectSendMode(mode: 'immediate' | 'scheduled') {
  sendMode.value = mode
  if (mode === 'scheduled')
    initScheduledTime()
}

function handleDateChange(e: any) {
  scheduledDate.value = e.detail.value
  initScheduledTime()
}

function handleTimeChange(e: any) {
  scheduledTime.value = e.detail.value
  initScheduledTime()
}

function handleSelectTemplate(tpl: typeof templates[0]) {
  message.value = tpl.preview
  showTemplatePanel.value = false
}

/** 点击「确认发送」：套餐配额发送或按次支付 */
async function handleConfirmSend() {
	// 登录身份在进入小程序时已静默建立；首次发送才要求绑定手机号。
	if (!user.info.value?.phone) {
		uni.navigateTo({ url: '/package-user/login' })
		return
	}

  if (isReplyMode.value && !replyContext.value) {
    uni.showToast({ title: replyContextLoading.value ? '正在获取回复对象' : '回复对象不可用', icon: 'none' })
    return
  }

  const rawPhone = phone.value.replace(/\s/g, '')
  if (!isReplyMode.value && (!rawPhone || !/^1\d{10}$/.test(rawPhone))) {
    uni.showToast({ title: '请输入正确的11位手机号', icon: 'none' })
    return
  }
  if (!message.value.trim()) {
    uni.showToast({ title: '请输入消息内容', icon: 'none' })
    return
  }
  if (sendMode.value === 'scheduled') {
    initScheduledTime()

    if (!scheduledAt.value) {
      uni.showToast({ title: '请选择定时发送时间', icon: 'none' })
      return
    }

    if (scheduledTooEarly.value) {
      uni.showToast({ title: '定时发送时间需晚于当前时间30分钟', icon: 'none' })
      return
    }
  }

  isCreatingOrder.value = true

  try {
    const messagePayload = {
      ...(!isReplyMode.value ? { receiverPhone: rawPhone } : {}),
      content: message.value,
      isAnonymous: isReplyMode.value ? 0 : isAnonymous.value ? 1 : 0,
      isPublic: isPublic.value ? 1 : 0,
      sendType: sendMode.value === 'scheduled' ? 2 : 1,
      ...(isReplyMode.value ? { conversationId: replyConversationId.value } : {}),
      ...(sendMode.value === 'scheduled' ? { scheduledAt: scheduledAt.value } : {}),
    }

    if (hasEnoughQuota.value) {
      // ── 场景 A：套餐配额充足，服务端生成套餐余额订单并发送 ──
      await sendMessage(messagePayload)
      // 本地更新配额显示
      userQuota.value = Math.max(0, userQuota.value - 1)
      uni.showToast({ title: '发送成功，等待审核', icon: 'none' })
      setTimeout(() => uni.navigateBack(), 1500)
    }
    else {
      // ── 场景 B：配额不足，创建按次支付订单后跳支付页 ──
      const order = await createOrder(messagePayload)
      uni.navigateTo({ url: `/package-order/pay?orderId=${order.id}` })
    }
  }
  catch (err: any) {
    uni.showToast({ title: err?.message || '操作失败，请重试', icon: 'none' })
  }
  finally {
    isCreatingOrder.value = false
  }
}
</script>

<template>
  <view class="min-h-[100vh] bg-[#fef7f5] text-[#4a2b24]">
    <cl-topbar
      :title="pageTitle"
      safeAreaTop
      fixed
      backgroundColor="#fef7f5"
      color="#4a2b24"
      height="88rpx"
      :pt="{ title: { className: 'text-[34rpx] font-[800]' } }"
    />

    <!-- Scrollable content -->
    <view class="px-[24rpx] pb-[200rpx]">

      <!-- Warning banner -->
      <view class="h-[72rpx] flex flex-row items-center border border-solid border-[#f5dcc0] rounded-[18rpx] bg-[#fef1e1] px-[18rpx]">
        <image :src="mergeOssPath('safe.png')" mode="aspectFit" class="h-[42rpx] w-[42rpx] flex-shrink-0" />
        <text class="ml-[12rpx] flex-1 text-[20rpx] text-[#6a3b29] leading-[32rpx]">
          善意是沟通的起点 💛 请确保你的消息真诚、得体，尊重对方的感受
        </text>
      </view>

      <!-- 收件人 section -->
      <view class="mt-[20rpx] rounded-[20rpx] bg-white px-[24rpx] pb-[20rpx] pt-[24rpx]" style="box-shadow: 0 4rpx 16rpx #fe89730f;">
        <text class="mb-[14rpx] block text-[28rpx] text-[#4a2b24]">收件人</text>
        <view v-if="isReplyMode" class="flex flex-row items-center gap-[16rpx] rounded-[16rpx] border border-solid border-[#f0e0d8] bg-[#fdf9f7] px-[20rpx] py-[14rpx]">
          <view class="h-[56rpx] w-[56rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-full bg-[#fff0ed]">
            <cl-icon name="user-line" :size="16" :pt="{ className: 'text-[#fe8973]' }" />
          </view>
          <view class="min-w-0 flex-1">
            <text class="block text-[28rpx] font-[700] text-[#4a2b24]">
              {{ replyContextLoading ? '正在获取回复对象...' : replyContext?.receiverPhoneDisplay || '回复对象不可用' }}
            </text>
            <text v-if="replyContext?.isPeerAnonymous" class="mt-[4rpx] block text-[21rpx] text-[#a08a84]">
              对方曾匿名发送，手机号不会展示
            </text>
          </view>
        </view>
        <view v-else class="flex flex-row items-center gap-[16rpx] rounded-[16rpx] border border-solid border-[#f0e0d8] bg-[#fdf9f7] px-[20rpx] py-[14rpx]">
          <input
            v-model="phone"
            type="number"
            class="min-w-0 flex-1 h-[56rpx] bg-transparent leading-[56rpx] text-[#4a2b24]"
            placeholder="请输入收件人手机号"
            placeholder-style="color: #d4c4be; font-weight: 400;"
          />
          <!--
          <view
            class="flex flex-row flex-shrink-0 items-center gap-[8rpx] rounded-[14rpx] bg-[#fff0ed] px-[18rpx] py-[14rpx]"
          >
            <cl-icon name="user-fill" :size="13" :pt="{ className: 'text-[#fe8973]' }" />
            <text class="text-[23rpx] text-[#fe8973] font-[600]">从通讯录导入</text>
          </view>
          -->
        </view>
        <text class="mt-[10rpx] block text-[23rpx] text-[#c4b3ae]">
          {{ isReplyMode ? '系统会将消息回复给原发送者' : '请输入收件人手机号，我们将帮你把心意送达' }}
        </text>
      </view>

      <!-- 消息内容 section -->
      <view class="mt-[16rpx] rounded-[20rpx] bg-white px-[24rpx] pb-[20rpx] pt-[20rpx]" style="box-shadow: 0 4rpx 16rpx #fe89730f;">
        <view class="mb-[14rpx] flex flex-row items-center justify-between">
          <text class="text-[28rpx] text-[#4a2b24]">消息内容</text>
          <text class="text-[22rpx] text-[#c4b3ae]">已输入 {{ message.length }}/{{ MESSAGE_LIMIT }} 字</text>
        </view>
        <textarea
          v-model="message"
          :maxlength="MESSAGE_LIMIT"
          class="box-border h-[220rpx] w-full rounded-[16rpx] border border-solid border-[#f0e0d8] bg-[#fdf9f7] px-[20rpx] py-[18rpx] text-[28rpx] text-[#4a2b24] leading-[44rpx]"
          placeholder="请输入你想传达的话..."
          placeholder-style="color: #c4b3ae;"
        />
        <view class="mt-[16rpx] flex flex-row items-center justify-between">
          <!-- AI 帮我写
          <view class="flex flex-row items-center gap-[8rpx] rounded-[50rpx] border border-solid border-[#dfd0f8] bg-[#faf7ff] px-[22rpx] py-[12rpx]">
            <cl-icon name="sparkling-fill" :size="12" :pt="{ className: 'text-[#9b6ee0]' }" />
            <text class="text-[24rpx] font-[600] text-[#9b6ee0]">AI 帮我写</text>
          </view>
          -->
          <view />
        </view>
      </view>

      <!-- Template panel (conditional) -->
      <view v-if="showTemplatePanel" class="mt-[16rpx] rounded-[20rpx] bg-white px-[24rpx] pb-[24rpx] pt-[20rpx]" style="box-shadow: 0 4rpx 16rpx #fe89730f;">
        <!-- Header -->
        <view class="mb-[16rpx] flex flex-row items-center justify-between">
          <text class="text-[26rpx] font-[700] text-[#4a2b24]">选择模板</text>
          <view class="h-[44rpx] w-[44rpx] flex flex-row items-center justify-center" @click="showTemplatePanel = false">
            <cl-icon name="close-line" :size="14" :pt="{ className: 'text-[#a08a84]' }" />
          </view>
        </view>
        <!-- Category tabs -->
        <scroll-view scroll-x class="mb-[18rpx] whitespace-nowrap" :show-scrollbar="false">
          <view class="inline-flex flex-row gap-[12rpx]">
            <view
              v-for="cat in categories"
              :key="cat"
              class="inline-flex flex-row items-center rounded-[50rpx] px-[22rpx] py-[9rpx]"
              :class="activeCategory === cat ? 'bg-[#fe8973]' : 'bg-[#f5ece9]'"
              @click="activeCategory = cat"
            >
              <text
                class="text-[23rpx] font-[600]"
                :class="activeCategory === cat ? 'text-white' : 'text-[#7a5147]'"
              >
                {{ cat }}
              </text>
            </view>
          </view>
        </scroll-view>
        <!-- Template cards grid (3 columns) -->
        <view class="grid grid-cols-3 gap-[14rpx]">
          <view
            v-for="tpl in filteredTemplates"
            :key="tpl.id"
            class="overflow-hidden rounded-[14rpx] bg-white"
            style="box-shadow: 0 2rpx 10rpx #fe89731a;"
            @click="handleSelectTemplate(tpl)"
          >
            <view
              class="h-[110rpx] w-full flex flex-row items-center justify-center"
              :style="{ backgroundColor: tpl.bgColor }"
            >
              <text class="text-[48rpx]">{{ tpl.emoji }}</text>
            </view>
            <view class="bg-white px-[10rpx] pb-[12rpx] pt-[8rpx]">
              <text class="block text-[22rpx] font-[700] text-[#4a2b24]">{{ tpl.title }}</text>
              <text class="mt-[4rpx] block text-[18rpx] text-[#a08a84] leading-[26rpx]" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                {{ tpl.preview }}
              </text>
            </view>
          </view>
        </view>
      </view>

      <!-- 发送方式 section -->
      <view class="mt-[16rpx] rounded-[20rpx] bg-white px-[24rpx] py-[24rpx]" style="box-shadow: 0 4rpx 16rpx #fe89730f;">
        <text class="mb-[16rpx] block text-[28rpx] text-[#4a2b24]">发送方式</text>
        <view class="">
          <view class="flex flex-row items-center justify-between">
            <view class="h-[64rpx] w-[64rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-[18rpx] bg-[#fff0ed]">
              <image :src="mergeOssPath('anonymous.png')" mode="aspectFit" class="h-full w-full" />
            </view>
            <text class="ml-[16rpx] min-w-0 flex-1 text-[28rpx] text-[#4a2b24]">{{ isReplyMode ? '实名回复' : '匿名发送' }}</text>
            <cl-switch
				v-if="!isReplyMode"
				class="ml-[16rpx] flex-shrink-0"
				v-model="isAnonymous"
            ></cl-switch>
			<text v-else class="rounded-[16rpx] bg-[#f5ece9] px-[18rpx] py-[8rpx] text-[22rpx] text-[#8c7771]">不可更改</text>
          </view>
          <text class="rounded-[18rpx] px-[20rpx] py-[18rpx] border border-solid border-[#f5dcc0] bg-[#fef1e1] mt-[12rpx] block text-[20rpx] text-[#a08a84] leading-[32rpx]">
            {{ isReplyMode ? '回复消息不能匿名发送，系统会自动关联到当前对话' : isAnonymous ? '收件人将收到一条来自「余语传话」的匿名消息，不会暴露你的身份' : '收件人将看到你的实名发送信息' }}
          </text>
        </view>
        <view class="mt-[18rpx] flex flex-row gap-[16rpx]">
          <view
            class="h-[80rpx] flex flex-row flex-1 items-center justify-center gap-[10rpx] rounded-[16rpx]"
            :class="sendMode === 'immediate' ? 'border border-solid border-[#fd8269] bg-[#feebe4]' : 'border border-solid border-[#f0e8e4] bg-[#fffaf8]'"
            @click="selectSendMode('immediate')"
          >
            <text
              class="text-[28rpx]"
              :class="sendMode === 'immediate' ? 'text-[#fd8269]' : 'text-[#7a5147]'"
            >
              ⚡
            </text>
            <text
              class="text-[28rpx]"
              :class="sendMode === 'immediate' ? 'text-[#fd8269]' : 'text-[#7a5147]'"
            >
              立即发送
            </text>
          </view>
          <view
            class="h-[80rpx] flex flex-row flex-1 items-center justify-center gap-[10rpx] rounded-[16rpx]"
            :class="sendMode === 'scheduled' ? 'border border-solid border-[#fd8269] bg-[#feebe4]' : 'border border-solid border-[#f0e8e4] bg-[#fffaf8]'"
            @click="selectSendMode('scheduled')"
          >
            <cl-icon name="time-line" :size="14" :color="sendMode === 'scheduled' ? '#fd8269' : '#7a5147'" />
            <text
              class="text-[28rpx]"
              :class="sendMode === 'scheduled' ? 'text-[#fd8269]' : 'text-[#7a5147]'"
            >
              定时发送
            </text>
          </view>
        </view>
        <view v-if="sendMode === 'scheduled'" class="mt-[18rpx] rounded-[16rpx] bg-[#fffaf8] px-[20rpx] py-[18rpx]">
          <view class="flex flex-row items-center gap-[16rpx]">
            <picker
              mode="date"
              :value="scheduledDate"
              :start="formatPickerDate(minScheduledAt)"
              class="flex-1"
              @change="handleDateChange"
            >
              <view class="h-[72rpx] flex flex-row items-center justify-center rounded-[14rpx] border border-solid border-[#f0e8e4] bg-white">
                <text class="text-[26rpx] font-[600] text-[#4a2b24]">{{ scheduledDate || '选择日期' }}</text>
              </view>
            </picker>
            <picker
              mode="time"
              :value="scheduledTime"
              class="flex-1"
              @change="handleTimeChange"
            >
              <view class="h-[72rpx] flex flex-row items-center justify-center rounded-[14rpx] border border-solid border-[#f0e8e4] bg-white">
                <text class="text-[26rpx] font-[600] text-[#4a2b24]">{{ scheduledTime || '选择时间' }}</text>
              </view>
            </picker>
          </view>
          <view class="mt-[12rpx] flex flex-row items-center justify-between">
            <text class="text-[22rpx] text-[#a08a84]">将于 {{ scheduledLabel }} 发送</text>
            <text v-if="scheduledTooEarly" class="text-[22rpx] text-[#fe8973]">需晚于当前时间30分钟</text>
          </view>
        </view>
        <view class="mt-[22rpx] border-t border-t-solid border-t-[#f5ece9] pt-[20rpx]">
          <view class="flex flex-row items-center justify-between">
            <view class="min-w-0 flex-1 pr-[20rpx]">
              <text class="block text-[28rpx] text-[#4a2b24]">公开到广场</text>
              <text class="mt-[6rpx] block text-[22rpx] text-[#a08a84] leading-[32rpx]">开启后，审核通过的内容将匿名展示在心意广场</text>
            </view>
            <cl-switch v-model="isPublic" class="flex-shrink-0" />
          </view>
        </view>
        <text class="mt-[12rpx] block text-[22rpx] text-[#c4b3ae]">
          定时发送最早可选时间：当前时间 + 30分钟
        </text>
      </view>
    </view>

    <!-- Fixed bottom action bar -->
    <view class="fixed bottom-0 left-0 right-0 border-t border-t-solid border-t-[#f0e8e4] bg-white px-[24rpx] pb-[48rpx] pt-[20rpx]">
      <view class="flex flex-row items-center justify-between gap-[20rpx]">
        <view class="min-w-0 flex flex-1 flex-col overflow-hidden">
          <text v-if="hasEnoughQuota" class="block truncate text-[20rpx] text-[#7a5147]">
            套餐余 {{ userQuota }} 条 · 本次扣 1 条
          </text>
          <text v-else class="block truncate text-[20rpx] text-[#7a5147]">预计费用（每10字 ¥1.99）</text>
          <view class="flex flex-row items-center gap-[6rpx]">
            <text v-if="hasEnoughQuota" class="text-[30rpx] font-[800] leading-[46rpx] text-[#4caf50]">
              套餐余额
            </text>
            <text v-else class="text-[38rpx] font-[800] leading-[46rpx] text-[#fe8973]">
              ¥{{ estimatedFee }}
            </text>
          </view>
        </view>
        <view
          class="h-[88rpx] w-[340rpx] flex flex-row flex-shrink-0 items-center justify-center rounded-[22rpx] bg-[#fe8973]"
          style="box-shadow: 0 8rpx 24rpx #fe89735c;"
          @click="!isCreatingOrder && handleConfirmSend()"
        >
          <text class="text-[32rpx] font-[800] text-white">{{ isCreatingOrder ? '处理中...' : hasEnoughQuota ? '确认发送' : '去支付' }}</text>
        </view>
      </view>
    </view>
  </view>
</template>
