# 打包路径，uniapp H5 专用
VITE_BASE_PATH=/

# 后端接口基础地址，本地后端默认端口 8001
VITE_APP_BASE_URL=http://192.168.10.112:8001

# OSS 开关：开发环境默认关闭，使用本地静态资源
VITE_APP_OSS_ON=on

# OSS 基础地址
VITE_APP_OSS_URL=https://bnsck-static.oss-cn-hangzhou.aliyuncs.com

# OSS 文件路径前缀
VITE_APP_OSS_PATH=/app/static/

# OSS 模板文件路径前缀
VITE_APP_OSS_TEMPLATE_PATH=
