<script setup lang="ts">
import { computed, ref } from "vue";
import { FEEDBACK_TYPES, submitFeedback, uploadImage } from '@/api/feedback'

const MAX_CONTENT = 500
const MAX_IMAGES = 4

const selectedType = ref(1)
const content = ref('')
const contact = ref('')
const images = ref<string[]>([])
const submitting = ref(false)

const contentLen = computed(() => content.value.length)
const typeRequired = ref(false)

function selectType(val: number) {
  selectedType.value = val
  typeRequired.value = false
}

function goHistory() {
  uni.navigateTo({ url: '/package-feedback/feedback-history' })
}

async function chooseImage() {
  if (images.value.length >= MAX_IMAGES) {
    uni.showToast({ title: `最多上传 ${MAX_IMAGES} 张`, icon: 'none' })
    return
  }
  const remain = MAX_IMAGES - images.value.length
  uni.chooseImage({
    count: remain,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: async (res) => {
      const paths = res.tempFilePaths
      uni.showLoading({ title: '上传中...' })
      try {
        for (const p of paths) {
          if (images.value.length >= MAX_IMAGES)
            break
          const url = await uploadImage(p)
          images.value.push(url)
        }
      }
      catch {
        uni.showToast({ title: '图片上传失败', icon: 'none' })
      }
      finally {
        uni.hideLoading()
      }
    },
  })
}

function removeImage(idx: number) {
  images.value.splice(idx, 1)
}

async function handleSubmit() {
  if (selectedType.value === undefined || selectedType.value === null) {
    typeRequired.value = true
    uni.showToast({ title: '请选择反馈类型', icon: 'none' })
    return
  }
  if (!content.value.trim()) {
    uni.showToast({ title: '请填写反馈内容', icon: 'none' })
    return
  }
  submitting.value = true
  try {
    await submitFeedback({
      type: selectedType.value,
      content: content.value.trim(),
      images: images.value,
      contact: contact.value.trim() || undefined,
    })
    uni.showToast({ title: '已收到反馈，感谢您的支持', icon: 'success', duration: 2000 })
    setTimeout(() => uni.navigateBack(), 2000)
  }
  catch {
    // error toast handled in request util
  }
  finally {
    submitting.value = false
  }
}
</script>

<template>
  <view class="min-h-[100vh] bg-[#fff8f6] text-[#4a2b24]">
    <cl-topbar
      title="意见反馈"
      safeAreaTop
      backgroundColor="transparent"
      color="#4a2b24"
      height="88rpx"
      :pt="{ title: { className: 'text-[34rpx] font-[800]' }, back: { size: 20 } }"
    >
      <template #append>
        <view class="mr-[24rpx]" @tap="goHistory">
          <text class="text-[26rpx] text-[#ff6b54]">历史记录</text>
        </view>
      </template>
    </cl-topbar>

    <!-- Banner -->
    <view class="mx-[28rpx] mb-[28rpx] flex flex-row items-center gap-[24rpx] rounded-[20rpx] bg-[linear-gradient(120deg,#fff3e0,#ffe8d6)] px-[28rpx] py-[24rpx] shadow-sm">
      <view class="flex flex-row h-[88rpx] w-[88rpx] flex-shrink-0 items-center justify-center rounded-[20rpx] bg-[linear-gradient(135deg,#ffd97d,#ff9b58)] shadow-md">
        <cl-icon name="heart-fill" :size="22" :pt="{ className: 'text-white' }" />
      </view>
      <view>
        <view class="text-[28rpx] font-semibold text-[#4a2b24]">
          你的每一条建议，都在帮助我们变得更好
          <text class="text-[24rpx]">💛</text>
        </view>
        <view class="mt-[8rpx] text-[22rpx] text-[#9b7060]">
          我们会认真对待你的反馈，持续优化产品体验
        </view>
      </view>
    </view>

    <view class="px-[28rpx]">
      <!-- 反馈类型 -->
      <view class="mb-[24rpx] rounded-[20rpx] bg-white px-[28rpx] py-[24rpx] shadow-sm">
        <view class="mb-[20rpx] flex flex-row items-center justify-between">
          <view class="flex flex-row items-center gap-[10rpx]">
            <view class="h-[32rpx] w-[6rpx] rounded-full bg-[#ff6b54]" />
            <text class="text-[28rpx] font-semibold">反馈类型</text>
          </view>
          <text class="text-[22rpx]" :class="typeRequired ? 'text-[#ff4444]' : 'text-[#ff6b54]'">
            反馈类型必选
          </text>
        </view>
        <view class="flex flex-row flex-wrap gap-[16rpx]">
          <view
            v-for="item in FEEDBACK_TYPES"
            :key="item.value"
            class="flex flex-row items-center gap-[8rpx] rounded-full px-[28rpx] py-[12rpx] text-[26rpx] transition-all"
            :class="selectedType === item.value
              ? 'bg-[#ff6b54] text-white shadow-md'
              : 'border border-[#e8d5cf] bg-[#fff8f6] text-[#7a5c54]'"
            @tap="selectType(item.value)"
          >
            <cl-icon v-if="selectedType === item.value" name="check-line" :size="11" />
            <text>{{ item.label }}</text>
          </view>
        </view>
      </view>

      <!-- 反馈内容 -->
      <view class="mb-[24rpx] rounded-[20rpx] bg-white px-[28rpx] py-[24rpx] shadow-sm">
        <view class="mb-[16rpx] flex flex-row items-center justify-between">
          <view class="flex flex-row items-center gap-[10rpx]">
            <view class="h-[32rpx] w-[6rpx] rounded-full bg-[#ff6b54]" />
            <text class="text-[28rpx] font-semibold">反馈内容</text>
          </view>
          <text class="text-[22rpx] text-[#b09090]">{{ contentLen }}/{{ MAX_CONTENT }}</text>
        </view>
        <textarea
          v-model="content"
          class="h-[200rpx] w-full rounded-[12rpx] bg-[#fff8f6] p-[20rpx] text-[26rpx] text-[#4a2b24]"
          :maxlength="MAX_CONTENT"
          placeholder="请详细描述问题或建议，便于我们更快定位和解决"
          placeholder-style="color:#c0a89a;font-size:26rpx"
          auto-height
        />
      </view>

      <!-- 图片上传 -->
      <view class="mb-[24rpx] rounded-[20rpx] bg-white px-[28rpx] py-[24rpx] shadow-sm">
        <view class="mb-[8rpx] flex flex-row items-center gap-[10rpx]">
          <view class="h-[32rpx] w-[6rpx] rounded-full bg-[#ff6b54]" />
          <text class="text-[28rpx] font-semibold">图片上传</text>
        </view>
        <text class="mb-[20rpx] block text-[22rpx] text-[#b09090]">最多上传 {{ MAX_IMAGES }} 张图片</text>
        <view class="flex flex-row flex-wrap gap-[16rpx]">
          <!-- 已上传图片 -->
          <view
            v-for="(img, idx) in images"
            :key="idx"
            class="relative h-[160rpx] w-[160rpx] overflow-hidden rounded-[12rpx]"
          >
            <image :src="img" class="h-full w-full" mode="aspectFill" />
            <view
              class="absolute right-[6rpx] top-[6rpx] flex flex-row h-[36rpx] w-[36rpx] items-center justify-center rounded-full bg-black/50"
              @tap="removeImage(idx)"
            >
              <cl-icon name="close-line" :size="11" :pt="{ className: 'text-white' }" />
            </view>
          </view>
          <!-- 添加按钮 -->
          <view
            v-if="images.length < MAX_IMAGES"
            class="flex h-[160rpx] w-[160rpx] flex-col items-center justify-center gap-[8rpx] rounded-[12rpx] border-[2rpx] border-dashed border-[#e0c8c0] bg-[#fff8f6]"
            @tap="chooseImage"
          >
            <cl-icon name="add-line" :size="24" :pt="{ className: 'text-[#e0a898]' }" />
            <text class="text-[22rpx] text-[#c0a89a]">添加图片</text>
          </view>
        </view>
        <text class="mt-[16rpx] block text-[22rpx] text-[#c0a89a]">支持 JPG、PNG 格式，单张不超过 5MB</text>
      </view>

      <!-- 联系方式 -->
      <view class="mb-[40rpx] rounded-[20rpx] bg-white px-[28rpx] py-[24rpx] shadow-sm">
        <view class="mb-[16rpx] flex flex-row items-center gap-[10rpx]">
          <view class="h-[32rpx] w-[6rpx] rounded-full bg-[#ff6b54]" />
          <text class="text-[28rpx] font-semibold">联系方式 <text class="text-[22rpx] font-normal text-[#b09090]">（可选）</text></text>
        </view>
        <view class="flex flex-row items-center gap-[16rpx] rounded-[12rpx] bg-[#fff8f6] px-[20rpx] py-[16rpx]">
          <cl-icon name="phone-line" :size="16" :pt="{ className: 'text-[#ff6b54]' }" />
          <input
            v-model="contact"
            class="flex-1 text-[26rpx] text-[#4a2b24]"
            placeholder="留下联系方式，方便我们与你跟进处理"
            placeholder-style="color:#c0a89a;font-size:26rpx"
            maxlength="50"
          />
        </view>
      </view>

      <!-- 提交按钮 -->
      <view
        class="mb-[40rpx] flex flex-row h-[96rpx] items-center justify-center rounded-full text-[30rpx] font-semibold text-white shadow-lg transition-opacity"
        :class="submitting ? 'bg-[#ffb09a] opacity-60' : 'bg-[linear-gradient(90deg,#ff8873,#ff5a3c)]'"
        @tap="!submitting && handleSubmit()"
      >
        {{ submitting ? '提交中...' : '提交反馈' }}
      </view>

      <!-- 底部提示 -->
      <view class="mb-[60rpx] flex flex-row items-center justify-center gap-[8rpx]">
        <cl-icon name="shield-check-line" :size="11" :pt="{ className: 'text-[#c0a89a]' }" />
        <text class="text-[22rpx] text-[#c0a89a]">你的反馈将被严格保密，我们会尽快处理</text>
      </view>
    </view>
  </view>
</template>
