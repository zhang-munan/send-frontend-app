<script setup lang="ts">
import { computed, ref } from "vue";
import { useStore } from '@/.cool'
import { ensureWechatMpSilentLogin } from '@/.cool/hooks/wx'
import { FEEDBACK_TYPES, submitFeedback, uploadImage } from '@/api/feedback'
import { loginByMiniCode } from '@/api/user'
import { mergeOssPath } from "@/utils/oss";

const MAX_CONTENT = 500
const MAX_IMAGES = 4

const { user } = useStore()
const selectedType = ref(1)
const content = ref('')
const contact = ref('')
const images = ref<string[]>([])
const submitting = ref(false)

const contentLen = computed(() => content.value.length)
const typeRequired = ref(false)
let userInitializationPromise: Promise<void> | null = null

/** 直达反馈页时，先按首页相同的流程建立静默登录态。 */
async function establishUser() {
  // #ifdef MP-WEIXIN
  try {
    const result: any = await new Promise((resolve, reject) => {
      uni.login({ provider: 'weixin', success: resolve, fail: reject })
    })
    if (result.code) {
      const token = await loginByMiniCode(result.code)
      user.setToken(token)
    }
  }
  catch (err) {
    console.warn('小程序静默登录失败', err)
  }
  // #endif

  // #ifdef H5
  await ensureWechatMpSilentLogin()
  // #endif

  await user.get()
}

function initializeUser() {
  if (userInitializationPromise === null)
    userInitializationPromise = establishUser()
  return userInitializationPromise
}

/** 有页面栈则正常返回；公众号直达时回到首页。 */
function goBack() {
  const pages = getCurrentPages()
  if (pages.length > 1) {
    uni.navigateBack()
    return
  }
  uni.switchTab({ url: '/pages/index' })
}

function selectType(val: number) {
  selectedType.value = val
  typeRequired.value = false
}

async function chooseImage() {
  await initializeUser()
  if (images.value.length >= MAX_IMAGES) {
    uni.showToast({ title: `最多上传 ${MAX_IMAGES} 张`, icon: 'none' })
    return
  }
  const remain = MAX_IMAGES - images.value.length
  uni.chooseImage({
    count: remain,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: async (res) => {
      const paths = res.tempFilePaths
      uni.showLoading({ title: '上传中...' })
      try {
        for (const p of paths) {
          if (images.value.length >= MAX_IMAGES)
            break
          const url = await uploadImage(p)
          images.value.push(url)
        }
      }
      catch {
        uni.showToast({ title: '图片上传失败', icon: 'none' })
      }
      finally {
        uni.hideLoading()
      }
    },
  })
}

function removeImage(idx: number) {
  images.value.splice(idx, 1)
}

async function handleSubmit() {
  if (selectedType.value === undefined || selectedType.value === null) {
    typeRequired.value = true
    uni.showToast({ title: '请选择反馈类型', icon: 'none' })
    return
  }
  if (!content.value.trim()) {
    uni.showToast({ title: '请填写反馈内容', icon: 'none' })
    return
  }
  await initializeUser()
  submitting.value = true
  try {
    await submitFeedback({
      type: selectedType.value,
      content: content.value.trim(),
      images: images.value,
      contact: contact.value.trim() || undefined,
    })
    uni.showToast({ title: '已收到反馈，感谢您的支持', icon: 'none', duration: 2000 })
    setTimeout(goBack, 2000)
  }
  catch {
    // error toast handled in request util
  }
  finally {
    submitting.value = false
  }
}

onLoad(initializeUser)
</script>

<template>
  <view class="min-h-[100vh] bg-[#fff9f7] text-[#302725]">
    <cl-topbar
      title="意见反馈"
      safeAreaTop
      fixed
      backgroundColor="#fff9f7"
      color="#302725"
      height="96rpx"
      :pt="{ title: { className: 'text-[34rpx] font-[700]' }, back: { size: 22 } }"
      :showBack="false"
    >
      <template #prepend>
        <view class="h-full w-[60rpx] flex flex-row items-center justify-center" @tap="goBack">
          <cl-icon name="arrow-left-s-line" :size="22" color="#302725" />
        </view>
      </template>
    </cl-topbar>

    <!-- Banner -->
    <view class="mx-[28rpx] mb-[20rpx] flex flex-row items-center gap-[24rpx] rounded-[28rpx] border border-solid border-[#ffddb0] bg-[#fdedd9] px-[28rpx] py-[24rpx] shadow-[0_8rpx_24rpx_#f4b97b26]">
      <view class="relative flex h-[90rpx] w-[90rpx] flex-shrink-0 items-center justify-center">
        <image :src="mergeOssPath('mine', 'feedback-safe.png')" class="h-full w-full" mode="aspectFill" />
      </view>
      <view class="flex-1">
        <view class="text-[27rpx] font-[500] text-[#302725] leading-[40rpx] flex-row">
          你的每一条建议，都在帮助我们变得更好
        </view>
        <view class="mt-[6rpx] text-[22rpx] text-[#8d7770] leading-[32rpx] block-inline flex-row">
          我们会认真对待你的反馈，持续优化产品体验
        </view>
      </view>
    </view>

    <view class="px-[28rpx] pb-[36rpx]">
      <!-- 反馈类型 -->
      <view class="mb-[20rpx] rounded-[28rpx] bg-white px-[20rpx] py-[24rpx] shadow-[0_10rpx_30rpx_#e9c5bb1c]">
        <view class="mb-[22rpx] flex flex-row items-center justify-between">
          <view class="flex flex-row items-center gap-[10rpx]">
            <view class="h-[30rpx] w-[6rpx] rounded-full bg-[#ff7074]" />
            <text class="text-[28rpx] font-[600]">反馈类型</text>
          </view>
          <text class="text-[22rpx]" :class="typeRequired ? 'text-[#ff4444]' : 'text-[#ff7774]'">
            反馈类型必选
          </text>
        </view>
        <view class="flex flex-row justify-between">
          <view
            v-for="item in FEEDBACK_TYPES"
            :key="item.value"
            class="flex h-[62rpx] w-[154rpx] flex-row items-center justify-center gap-[8rpx] rounded-full text-[22rpx] transition-all"
            :class="selectedType === item.value
              ? 'bg-[#fd807b] text-white shadow-[0_8rpx_16rpx_#ff77744d]'
              : 'border border-solid border-[#f1e3df] bg-[#fffafa] text-[#4f4542]'"
            @tap="selectType(item.value)"
          >
            <text>{{ item.label }}</text>
            <view v-if="selectedType === item.value" class="bg-white rounded-full p-[2rpx]">
              <cl-icon v-if="selectedType === item.value" name="check-line" :size="11" color="#fd807b" />
            </view>
          </view>
        </view>
      </view>

      <!-- 反馈内容 -->
      <view class="mb-[20rpx] rounded-[28rpx] bg-white px-[20rpx] py-[24rpx] shadow-[0_10rpx_30rpx_#e9c5bb1c]">
        <view class="mb-[16rpx] flex flex-row items-center justify-between">
          <view class="flex flex-row items-center gap-[10rpx]">
            <view class="h-[30rpx] w-[6rpx] rounded-full bg-[#ff7074]" />
            <text class="text-[28rpx] font-[600]">反馈内容</text>
          </view>
          <text class="text-[22rpx] text-[#b09090]">{{ contentLen }}/{{ MAX_CONTENT }}</text>
        </view>
        <textarea
          v-model="content"
          class="h-[190rpx] w-full rounded-[18rpx] border border-solid border-[#eee2de] bg-[#fffdfc] p-[20rpx] text-[26rpx] text-[#4a2b24] leading-[40rpx]"
          :maxlength="MAX_CONTENT"
          placeholder="请详细描述问题或建议，便于我们更快定位和解决"
          placeholder-style="color:#c0a89a;font-size:26rpx"
        />
        <text class="mt-[14rpx] block text-[20rpx] text-[#aaa09c]">请详细描述问题或建议，便于我们更快定位和解决</text>
      </view>

      <!-- 图片上传 -->
      <view class="mb-[20rpx] rounded-[28rpx] bg-white px-[20rpx] py-[24rpx] shadow-[0_10rpx_30rpx_#e9c5bb1c]">
        <view class="mb-[8rpx] flex flex-row items-center gap-[10rpx]">
          <view class="h-[30rpx] w-[6rpx] rounded-full bg-[#ff7074]" />
          <text class="text-[28rpx] font-[600]">图片上传</text>
        </view>
        <text class="mb-[20rpx] block text-[22rpx] text-[#b09090]">最多上传 {{ MAX_IMAGES }} 张图片</text>
        <view class="flex flex-row flex-wrap gap-[16rpx]">
          <!-- 已上传图片 -->
          <view
            v-for="(img, idx) in images"
            :key="idx"
            class="relative h-[166rpx] w-[166rpx] overflow-hidden rounded-[16rpx]"
          >
            <image :src="img" class="h-full w-full" mode="aspectFill" />
            <view
              class="absolute right-[6rpx] top-[6rpx] flex flex-row h-[36rpx] w-[36rpx] items-center justify-center rounded-full bg-black/50"
              @tap="removeImage(idx)"
            >
              <cl-icon name="close-line" :size="11" :pt="{ className: 'text-white' }" />
            </view>
          </view>
          <!-- 添加按钮 -->
          <view
            v-if="images.length < MAX_IMAGES"
            class="flex h-[166rpx] w-[166rpx] flex-col items-center justify-center gap-[8rpx] rounded-[16rpx] border-[1px] border-dashed border-[#ffd5cc] bg-[#fffdfc]"
            @tap="chooseImage"
          >
            <cl-icon name="add-line" :size="26" :pt="{ className: 'text-[#ff7e78]' }" />
            <text class="text-[22rpx] text-[#c0a89a]">添加图片</text>
          </view>
        </view>
        <text class="mt-[16rpx] block text-[22rpx] text-[#c0a89a]">支持 JPG、PNG 格式，单张不超过 5MB</text>
      </view>

      <!-- 联系方式 -->
      <view class="mb-[16rpx] rounded-[28rpx] bg-white px-[20rpx] py-[24rpx] shadow-[0_10rpx_30rpx_#e9c5bb1c]">
        <view class="mb-[16rpx] flex flex-row items-center gap-[10rpx]">
          <view class="h-[30rpx] w-[6rpx] rounded-full bg-[#ff7074]" />
          <text class="text-[28rpx] font-[600]">联系方式 <text class="text-[22rpx] font-normal text-[#8f8581]">（可选）</text></text>
        </view>
        <view class="flex flex-row items-center gap-[16rpx] rounded-[16rpx] border border-solid border-[#eee2de] bg-[#fef9f7] px-[20rpx] py-[16rpx]">
          <cl-icon name="phone-fill" :size="16" color="#fe7881" />
          <input
            v-model="contact"
            class="flex-1 text-[26rpx] text-[#4a2b24]"
            placeholder="请输入手机号"
            placeholder-style="color:#c0a89a;font-size:26rpx"
            maxlength="50"
          />
        </view>
        <view class="mt-[16rpx] block text-[22rpx] text-[#c0a89a]">留下联系方式，方便我们与你跟进处理</view>
      </view>

      <!-- 提交按钮 -->
      <cl-button
        size="large"
        :loading="submitting"
        :disabled="submitting"
        :pt="{
          className: `mb-[12rpx] !h-[88rpx] w-full !rounded-[20rpx] !border-transparent !shadow-[0_10rpx_24rpx_#ff777452] ${submitting ? '!bg-[#ffb2ab]' : '!bg-[linear-gradient(90deg,#ff7774,#ff676d)]'}`,
          label: { className: 'text-[30rpx] text-white leading-[42rpx] font-[500]' },
          loading: { className: 'mr-[12rpx]' },
        }"
        @click="handleSubmit"
      >
        {{ submitting ? '提交中...' : '提交反馈' }}
      </cl-button>

      <!-- 底部提示 -->
      <view class="mb-[28rpx] flex flex-row items-center justify-center gap-[8rpx]">
        <cl-icon name="shield-check-line" :size="12" color="#b9b0ad" />
        <text class="text-[20rpx] text-[#b9b0ad]">你的反馈将被严格保密，我们会尽快处理</text>
      </view>
    </view>
  </view>
</template>
