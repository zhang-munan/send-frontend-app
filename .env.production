# 打包路径，uniapp H5 专用
VITE_BASE_PATH=/

# 后端接口基础地址，替换为实际生产域名
VITE_APP_BASE_URL=https://api.example.com

# OSS 开关：生产环境开启
VITE_APP_OSS_ON=on

# OSS 基础地址，替换为实际 CDN/OSS 域名
VITE_APP_OSS_URL=https://bnsck-static.oss-cn-hangzhou.aliyuncs.com

# OSS 文件路径前缀
VITE_APP_OSS_PATH=/send/app/static/

# OSS 模板文件路径前缀
VITE_APP_OSS_TEMPLATE_PATH=/send/bangni/templates/
